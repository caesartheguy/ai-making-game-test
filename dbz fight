<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Stickman Z Fighter: Ultimate Edition</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&display=swap');

        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(to bottom, #1a1a2e, #0f0f1e);
            color: white;
            font-family: 'Orbitron', sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            overflow: hidden;
        }

        #gameContainer {
            position: relative;
            width: 900px;
            height: 600px;
            border: 3px solid #00ffff;
            box-shadow: 0 0 30px #00ffff;
            background: #000;
        }

        #menuScreen, #endScreen {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.9);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            z-index: 10;
        }

        #endScreen { display: none; }

        h1 { font-size: 2.5em; font-weight: 900; color: #ff00ff; text-shadow: 0 0 15px #ff00ff; margin-bottom: 20px; }
        .selection-area { display: flex; justify-content: space-around; width: 90%; margin-bottom: 20px; }
        .player-select { border: 2px solid; padding: 15px; border-radius: 10px; width: 380px; }
        .player-select.p1 { border-color: '#00ffff'; box-shadow: 0 0 10px '#00ffff'; }
        .player-select.p2 { border-color: '#ff00ff'; box-shadow: 0 0 10px '#ff00ff'; }
        .player-select h2 { text-align: center; margin-top: 0; }
        .select-group { margin: 10px 0; }
        .select-group label { display: block; margin-bottom: 5px; font-size: 0.8em; }
        .select-group button {
            width: 48%; padding: 8px; margin: 1%; border: 1px solid #555; background: #222; color: white;
            cursor: pointer; font-family: 'Orbitron', sans-serif; transition: all 0.3s ease; font-size: 0.8em;
        }
        .select-group button.three-way { width: 31.5%; }
        .select-group button.selected {
            background: '#444'; border-color: '#00ffff'; box-shadow: 0 0 5px '#00ffff';
        }
        .player-select.p2 .select-group button.selected {
            border-color: '#ff00ff'; box-shadow: 0 0 5px '#ff00ff';
        }
        #startButton, #restartButton {
            padding: 15px 40px; font-size: 1.2em; font-weight: 700; background: linear-gradient(45deg, '#00ffff', '#ff00ff');
            border: none; color: '#000'; cursor: pointer; border-radius: 50px; transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        #startButton:hover, #restartButton:hover { transform: scale(1.1); box-shadow: 0 0 20px '#fff'; }
        #gameCanvas { display: none; }
    </style>
</head>
<body>

<div id="gameContainer">
    <div id="menuScreen">
        <h1>STICKMAN Z FIGHTER</h1>
        <div class="selection-area">
            <div class="player-select p1">
                <h2>Player 1</h2>
                <div class="select-group"><label>Power Style</label><button class="power-btn p1-power" data-player="1" data-type="power" data-value="kiWarrior">Ki Warrior</button><button class="power-btn p1-power" data-player="1" data-type="power" data-value="elementalMaster">Elemental</button></div>
                <div class="select-group"><label>Hair Style</label><button class="hair-btn p1-hair three-way" data-player="1" data-type="hair" data-value="goku">Goku</button><button class="hair-btn p1-hair three-way" data-player="1" data-type="hair" data-value="vegeta">Vegeta</button><button class="hair-btn p1-hair three-way" data-player="1" data-type="hair" data-value="broly">Broly</button></div>
            </div>
            <div class="player-select p2">
                <h2>Player 2</h2>
                <div class="select-group"><label>Power Style</label><button class="power-btn p2-power" data-player="2" data-type="power" data-value="kiWarrior">Ki Warrior</button><button class="power-btn p2-power" data-player="2" data-type="power" data-value="elementalMaster">Elemental</button></div>
                <div class="select-group"><label>Hair Style</label><button class="hair-btn p2-hair three-way" data-player="2" data-type="hair" data-value="goku">Goku</button><button class="hair-btn p2-hair three-way" data-player="2" data-type="hair" data-value="vegeta">Vegeta</button><button class="hair-btn p2-hair three-way" data-player="2" data-type="hair" data-value="broly">Broly</button></div>
            </div>
        </div>
        <button id="startButton">START FIGHT!</button>
    </div>

    <canvas id="gameCanvas" width="900" height="600"></canvas>
    <div id="endScreen"><h1 id="winnerText">PLAYER 1 WINS!</h1><button id="restartButton">PLAY AGAIN</button></div>
</div>

<script>
    const canvas = document.getElementById('gameCanvas'); const ctx = canvas.getContext('2d');
    const menuScreen = document.getElementById('menuScreen'); const endScreen = document.getElementById('endScreen'); const winnerText = document.getElementById('winnerText');

    const POWERS = {
        kiWarrior: { name: 'Ki Warrior', color: '#00ffff', primary: { name: 'Kamehameha', cost: 50, damage: 30, speed: 8, color: '#00ffff', type: 'beam' }, secondary: { name: 'Ki Scatter', cost: 30, damage: 4, speed: 7, color: '#00ffff', type: 'scatter' } },
        elementalMaster: { name: 'Elemental Master', color: '#ff6600', primary: { name: 'Blizzard', cost: 50, damage: 5, speed: 0, color: '#99ddff', type: 'blizzard' }, secondary: { name: 'Fire Pillar', cost: 30, damage: 15, speed: 0, color: '#ff4500', type: 'pillar' } }
    };

    const HAIRS = {
        goku: {
            name: 'Goku', color: '#ffdb00', createStrands: () => {
                let strands = [];
                for(let i = 0; i < 30; i++) {
                    const angle = (i / 30) * Math.PI - Math.PI / 2;
                    strands.push({ baseAngle: angle, length: Math.random() * 15 + 15, width: Math.random() * 3 + 2, phase: Math.random() * Math.PI * 2 });
                }
                return strands;
            }
        },
        vegeta: {
            name: 'Vegeta', color: '#ffdb00', createStrands: () => {
                let strands = [];
                for(let i = 0; i < 25; i++) {
                    const angle = (i / 25) * (Math.PI/2) - Math.PI/2 - 0.3;
                    strands.push({ baseAngle: angle, length: Math.random() * 12 + 12, width: Math.random() * 2 + 2, phase: Math.random() * Math.PI * 2 });
                }
                return strands;
            }
        },
        broly: {
            name: 'Broly', color: '#00ff00', createStrands: () => {
                let strands = [];
                for(let i = 0; i < 35; i++) {
                    const angle = (i / 35) * Math.PI - Math.PI / 2;
                    strands.push({ baseAngle: angle, length: Math.random() * 20 + 20, width: Math.random() * 4 + 3, phase: Math.random() * Math.PI * 2 });
                }
                return strands;
            }
        }
    };

    let gameState = 'MENU'; let player1Config = { power: null, hair: null }; let player2Config = { power: null, hair: null }; let player1, player2; let projectiles = []; let particles = []; let backgroundParticles = []; let keys = {};

    class Player {
        constructor(x, y, controls, config, playerNum) {
            this.x = x; this.y = y; this.vx = 0; this.vy = 0; this.width = 40; this.height = 70;
            this.controls = controls; this.playerNum = playerNum; this.color = playerNum === 1 ? '#00ffff' : '#ff00ff';
            this.health = 100; this.maxHealth = 100; this.displayHealth = 100;
            this.energy = 100; this.maxEnergy = 100;
            this.power = POWERS[config.power]; this.hairStyle = HAIRS[config.hair];
            this.hairStrands = this.hairStyle.createStrands();
            
            this.isGrounded = false; this.isFlying = false; this.facing = playerNum === 1 ? 1 : -1;
            this.isBlocking = false; this.hitstun = 0;
            this.blastCooldown = 0; this.punchCooldown = 0; this.kickCooldown = 0;
            this.specialCooldown = 0; this.secondaryCooldown = 0;
            this.isCharging = false;
            
            // Animation States
            this.state = 'IDLE';
            this.punchFrame = 0; this.kickFrame = 0;
            this.rotation = 0; // For kick animation
            this.afterimages = [];
        }

        update() {
            if (this.hitstun > 0) { this.hitstun--; this.vx *= 0.9; this.state = 'HITSTUN'; }
            else if (this.isPunching) { this.state = 'PUNCHING'; this.punchFrame++; if (this.punchFrame > 10) { this.isPunching = false; this.punchFrame = 0; this.state = 'IDLE'; } }
            else if (this.isKicking) { this.state = 'KICKING'; this.kickFrame++; this.rotation = (this.kickFrame / 15) * Math.PI * 1.5 * this.facing; if (this.kickFrame > 15) { this.isKicking = false; this.kickFrame = 0; this.rotation = 0; this.state = 'IDLE'; } }
            else if (this.isCharging) { this.state = 'CHARGING'; }
            else { this.state = 'IDLE'; }

            if (this.blastCooldown > 0) this.blastCooldown -= 16; if (this.punchCooldown > 0) this.punchCooldown -= 16; if (this.kickCooldown > 0) this.kickCooldown -= 16;
            if (this.specialCooldown > 0) this.specialCooldown -= 16; if (this.secondaryCooldown > 0) this.secondaryCooldown -= 16;
            if (this.energy < this.maxEnergy) this.energy += 0.15;
            if (this.displayHealth > this.health) this.displayHealth -= (this.displayHealth - this.health) * 0.1;

            // Afterimages
            this.afterimages = this.afterimages.filter(img => { img.alpha -= 0.05; return img.alpha > 0; });

            if (this.state !== 'HITSTUN' && this.state !== 'KICKING') {
                if (keys[this.controls.left]) { this.vx = -5; this.facing = -1; } else if (keys[this.controls.right]) { this.vx = 5; this.facing = 1; } else this.vx *= 0.8;
                
                // Flying
                if (keys[this.controls.up]) {
                    if (this.isGrounded) this.vy = -15; // Jump
                    else if (this.energy > 0) { this.isFlying = true; this.vy = -4; this.energy -= 0.3; } // Fly
                } else {
                    this.isFlying = false;
                }
            }

            if (keys[this.controls.dash] && Math.abs(this.vx) > 0.1 && this.energy > 5) {
                this.afterimages.push({ x: this.x, y: this.y, facing: this.facing, alpha: 0.5 });
                this.vx *= 2.5; this.energy -= 5; createDashEffect(this.x + this.width/2, this.y + this.height/2);
            }

            if (keys[this.controls.blast] && this.blastCooldown <= 0) { this.isCharging = true; }
            if (!keys[this.controls.blast] && this.isCharging) { this.energyBlast(); this.isCharging = false; }
            if (keys[this.controls.punch] && this.punchCooldown <= 0 && this.state === 'IDLE') this.punch();
            if (keys[this.controls.kick] && this.kickCooldown <= 0 && this.state === 'IDLE') this.kick();
            this.isBlocking = keys[this.controls.block];
            if (keys[this.controls.special] && this.specialCooldown <= 0 && this.energy >= this.power.primary.cost) this.primarySpecial();
            if (keys[this.controls.secondary] && this.secondaryCooldown <= 0 && this.energy >= this.power.secondary.cost) this.secondarySpecial();

            if (!this.isFlying) this.vy += 0.8; // Gravity
            this.x += this.vx; this.y += this.vy;
            if (this.x < 0) this.x = 0; if (this.x + this.width > canvas.width) this.x = canvas.width - this.width;
            if (this.y + this.height > canvas.height - 50) { this.y = canvas.height - 50 - this.height; this.vy = 0; this.isGrounded = true; this.isFlying = false; } else { this.isGrounded = false; }

            // Update hair physics
            this.hairStrands.forEach(strand => {
                strand.currentAngle = strand.baseAngle + (this.vx * 0.02) + Math.sin(Date.now()/500 + strand.phase) * 0.05;
            });
        }

        draw() {
            // Draw afterimages
            this.afterimages.forEach(img => {
                ctx.save(); ctx.globalAlpha = img.alpha; ctx.translate(img.x + this.width / 2, img.y + this.height / 2); ctx.scale(img.facing, 1);
                ctx.strokeStyle = this.color; ctx.lineWidth = 3;
                ctx.beginPath(); ctx.arc(0, -this.height/2 + 10, 10, 0, Math.PI * 2); ctx.stroke();
                ctx.beginPath(); ctx.moveTo(0, -this.height/2 + 20); ctx.lineTo(0, 0); ctx.stroke();
                ctx.restore();
            });

            ctx.save(); ctx.translate(this.x + this.width / 2, this.y + this.height / 2);
            if (this.state === 'KICKING') ctx.rotate(this.rotation);
            ctx.scale(this.facing, 1);
            
            if (this.hitstun > 0 && this.hitstun % 4 < 2) { ctx.globalAlpha = 0.5; ctx.fillStyle = 'red'; ctx.fillRect(-this.width/2, -this.height/2, this.width, this.height); ctx.globalAlpha = 1; }
            ctx.strokeStyle = this.color; ctx.lineWidth = 3; ctx.lineCap = 'round';
            
            // Head
            ctx.beginPath(); ctx.arc(0, -this.height/2 + 10, 10, 0, Math.PI * 2); ctx.stroke();
            this.hairStyle.draw(ctx, 0, -this.height/2 + 10, this.hairStrands);
            
            // Body
            ctx.beginPath(); ctx.moveTo(0, -this.height/2 + 20); ctx.lineTo(0, 0); ctx.stroke();
            
            // Arms
            let armAngle = 0.2;
            if (this.state === 'PUNCHING') armAngle = -1.2 * (this.punchFrame / 10);
            if (this.state === 'CHARGING') armAngle = -0.5;
            ctx.beginPath(); ctx.moveTo(0, -this.height/2 + 30); ctx.lineTo(-15, -this.height/2 + 45 + Math.sin(Date.now()/100)*2);
            ctx.moveTo(0, -this.height/2 + 30); ctx.lineTo(15, -this.height/2 + 45 + Math.sin(Date.now()/100 + 1)*2); ctx.stroke();
            
            // Punch animation
            if (this.state === 'PUNCHING') {
                ctx.strokeStyle = this.color; ctx.lineWidth = 4;
                const punchReach = 30 * (this.punchFrame / 10);
                ctx.beginPath(); ctx.moveTo(15, -this.height/2 + 45); ctx.lineTo(15 + punchReach, -this.height/2 + 45); ctx.stroke();
            }
            if (this.state === 'CHARGING') { ctx.fillStyle = 'rgba(255, 255, 255, 0.5)'; ctx.beginPath(); ctx.arc(15, -this.height/2 + 45, 5 + Math.sin(Date.now()/100)*2, 0, Math.PI * 2); ctx.fill(); }

            // Legs
            let legAngle = 0;
            if (this.state === 'KICKING') legAngle = -1.5 * (this.kickFrame / 15);
            else if (Math.abs(this.vx) > 1 && this.state === 'IDLE') legAngle = Math.sin(Date.now()/100) * 0.3;
            ctx.beginPath(); ctx.moveTo(0, 0); ctx.lineTo(-10, this.height/2 - 10 + legAngle*10);
            ctx.moveTo(0, 0); ctx.lineTo(10, this.height/2 - 10); ctx.stroke();
            
            // Block Shield
            if (this.isBlocking) { ctx.strokeStyle = `rgba(255, 255, 255, ${0.3 + Math.sin(Date.now()/100) * 0.2})`; ctx.lineWidth = 3; ctx.beginPath(); ctx.arc(0,0, this.width/2 + 10, 0, Math.PI * 2); ctx.stroke(); }
            ctx.restore();
        }

        energyBlast() { this.blastCooldown = 300; const orb = { x: this.x + (this.facing === 1 ? this.width : 0), y: this.y + this.height / 2, vx: 10 * this.facing, vy: 0, width: 12, height: 12, damage: 8, color: this.power.color, owner: this.playerNum, type: 'orb' }; projectiles.push(orb); }
        punch() { this.isPunching = true; this.punchCooldown = 400; setTimeout(() => { const opponent = this.playerNum === 1 ? player2 : player1; const hitbox = { x: this.x + (this.facing === 1 ? this.width : -20), y: this.y + this.height/2 - 10, radius: 10 }; if (checkCircleRectCollision(hitbox, opponent)) { opponent.takeDamage(10, this.facing * 3, -2); createHitEffect(opponent.x + opponent.width/2, opponent.y + opponent.height/2); } }, 200); }
        kick() { this.isKicking = true; this.kickCooldown = 600; setTimeout(() => { const opponent = this.playerNum === 1 ? player2 : player1; const hitbox = { x: this.x + (this.facing === 1 ? this.width : -40), y: this.y + this.height/2, radius: 15 }; if (checkCircleRectCollision(hitbox, opponent)) { opponent.takeDamage(15, this.facing * 12, -6); createHitEffect(opponent.x + opponent.width/2, opponent.y + opponent.height/2); } }, 400); }
        primarySpecial() { this.energy -= this.power.primary.cost; this.specialCooldown = 2000; const atk = this.power.primary; if (atk.type === 'beam') { const beam = { x: this.x + (this.facing === 1 ? this.width : -30), y: this.y + this.height / 2 - 15, width: 30, height: 30, vx: atk.speed * this.facing, vy: 0, damage: atk.damage, color: atk.color, owner: this.playerNum, type: 'beam' }; projectiles.push(beam); } else if (atk.type === 'blizzard') { for (let i = 0; i < 20; i++) setTimeout(() => { const flake = { x: Math.random() * canvas.width, y: -10, width: 10, height: 10, vx: (Math.random() - 0.5) * 2, vy: Math.random() * 3 + 2, damage: atk.damage, color: atk.color, owner: this.playerNum, type: 'blizzard', lifetime: 120 }; projectiles.push(flake); }, i * 50); } }
        secondarySpecial() { this.energy -= this.power.secondary.cost; this.secondaryCooldown = 1500; const atk = this.power.secondary; if (atk.type === 'scatter') { for (let i = -1; i <= 1; i++) { const proj = { x: this.x + this.width/2, y: this.y + this.height/2, width: 8, height: 8, vx: atk.speed * this.facing, vy: i * 3, damage: atk.damage, color: atk.color, owner: this.playerNum, type: 'projectile' }; projectiles.push(proj); } } else if (atk.type === 'pillar') { const opponent = this.playerNum === 1 ? player2 : player1; const pillar = { x: opponent.x + opponent.width/2 - 25, y: canvas.height - 50, width: 50, height: 0, targetHeight: 200, damage: atk.damage, color: atk.color, owner: this.playerNum, type: 'pillar', lifetime: 60 }; projectiles.push(pillar); } }
        takeDamage(amount, knockbackX = 0, knockbackY = 0) { if (this.isBlocking) { amount *= 0.2; this.energy -= 1; } this.health -= amount; this.hitstun = 15; this.vx += knockbackX; this.vy += knockbackY; if (this.health <= 0) { this.health = 0; endGame(this.playerNum === 1 ? 2 : 1); } }
    }
    
    // Helper for new hair drawing
    HAIRS.goku.draw = (ctx, x, y, strands) => {
        ctx.save();
        ctx.translate(x, y);
        ctx.rotate(-Math.PI / 2);
        ctx.fillStyle = HAIRS.goku.color;
        strands.forEach(strand => {
            ctx.beginPath();
            ctx.moveTo(0, 0);
            const tipX = Math.cos(strand.currentAngle) * strand.length;
            const tipY = Math.sin(strand.currentAngle) * strand.length;
            ctx.lineTo(tipX, tipY);
            ctx.lineTo(tipX + 5, tipY);
            ctx.closePath();
            ctx.fill();
        });
        ctx.restore();
    };
    HAIRS.vegeta.draw = HAIRS.goku.draw;
    HAIRS.broly.draw = HAIRS.goku.draw;


    class Particle { constructor(x, y, vx, vy, color, lifetime) { this.x = x; this.y = y; this.vx = vx; this.vy = vy; this.color = color; this.lifetime = lifetime; this.maxLifetime = lifetime; } update() { this.x += this.vx; this.y += this.vy; this.vy += 0.1; this.lifetime--; } draw() { ctx.save(); ctx.globalAlpha = this.lifetime / this.maxLifetime; ctx.fillStyle = this.color; ctx.fillRect(this.x, this.y, 4, 4); ctx.restore(); } }
    class FireParticle { constructor(x, y) { this.x = x; this.y = y; this.vx = (Math.random() - 0.5) * 0.5; this.vy = -Math.random() * 2 - 1; this.size = Math.random() * 15 + 5; this.lifetime = Math.random() * 30 + 30; } update() { this.x += this.vx; this.y += this.vy; this.vy *= 0.98; this.lifetime--; this.size *= 0.98; } draw() { ctx.save(); ctx.globalAlpha = this.lifetime / 60; const gradient = ctx.createRadialGradient(this.x, this.y, 0, this.x, this.y, this.size); gradient.addColorStop(0, 'rgba(255, 255, 100, 0.8)'); gradient.addColorStop(0.4, 'rgba(255, 150, 0, 0.6)'); gradient.addColorStop(1, 'rgba(255, 0, 0, 0)'); ctx.fillStyle = gradient; ctx.fillRect(this.x - this.size, this.y - this.size, this.size * 2, this.size * 2); ctx.restore(); } }

    function checkCircleRectCollision(circle, rect) {
        const distX = Math.abs(circle.x - rect.x - rect.width / 2);
        const distY = Math.abs(circle.y - rect.y - rect.height / 2);
        if (distX > (rect.width / 2 + circle.radius)) return false;
        if (distY > (rect.height / 2 + circle.radius)) return false;
        if (distX <= rect.width / 2) return true;
        if (distY <= rect.height / 2) return true;
        const dx = distX - rect.width / 2; const dy = distY - rect.height / 2; return (dx * dx + dy * dy <= circle.radius * circle.radius);
    }
    function createHitEffect(x, y) { for (let i = 0; i < 10; i++) particles.push(new Particle(x, y, (Math.random() - 0.5) * 8, (Math.random() - 0.5) * 8, '#ffff00', 20)); }
    function createDashEffect(x, y) { for (let i = 0; i < 5; i++) particles.push(new Particle(x, y, (Math.random() - 0.5) * 4, (Math.random() - 0.5) * 4, '#ffffff', 15)); }
    
    function drawUI() {
        // P1 UI
        drawBar(20, 20, 350, 25, player1.displayHealth / player1.maxHealth, '#ff0000', '#ffff00', player1.health < 30);
        drawBar(20, 50, 350, 25, player1.energy / player1.maxEnergy, '#0099ff', '#00ffff', player1.energy >= player1.maxEnergy - 1);
        ctx.fillStyle = '#fff'; ctx.font = '12px Orbitron'; ctx.fillText('P1', 20, 15);

        // P2 UI
        drawBar(canvas.width - 370, 20, 350, 25, player2.displayHealth / player2.maxHealth, '#ff0000', '#ffff00', player2.health < 30);
        drawBar(canvas.width - 370, 50, 350, 25, player2.energy / player2.maxEnergy, '#0099ff', '#00ffff', player2.energy >= player2.maxEnergy - 1);
        ctx.fillStyle = '#fff'; ctx.font = '12px Orbitron'; ctx.fillText('P2', canvas.width - 370, 15);
    }

    function drawBar(x, y, width, height, percentage, color1, color2, specialEffect) {
        const segmentWidth = width / 20;
        ctx.fillStyle = '#333'; ctx.fillRect(x, y, width, height);
        const gradient = ctx.createLinearGradient(x, y, x + width, y); gradient.addColorStop(0, color1); gradient.addColorStop(1, color2);
        ctx.fillStyle = gradient;
        for (let i = 0; i < 20; i++) {
            if (percentage * 20 > i) {
                ctx.fillRect(x + i * segmentWidth + 1, y + 1, segmentWidth - 2, height - 2);
            }
        }
        if (specialEffect) {
            ctx.strokeStyle = percentage > 0.5 ? 'rgba(255,255,255,0.5)' : 'rgba(255,0,0,0.8)';
            ctx.lineWidth = 2;
            ctx.strokeRect(x, y, width, height);
        }
    }
    
    function gameLoop() {
        if (gameState !== 'PLAYING') return;
        ctx.fillStyle = '#1a0f0a'; ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.fillStyle = '#2d1810'; ctx.fillRect(0, canvas.height - 50, canvas.width, 50);
        ctx.strokeStyle = '#3d2810'; ctx.lineWidth = 2; for(let i = 0; i < canvas.width; i+= 20) { ctx.beginPath(); ctx.moveTo(i, canvas.height - 50); ctx.lineTo(i + 5, canvas.height - 55); ctx.stroke(); }
        backgroundParticles = backgroundParticles.filter(p => { p.update(); p.draw(); return p.lifetime > 0; });
        if (Math.random() < 0.3) backgroundParticles.push(new FireParticle(Math.random() * canvas.width, canvas.height - 50));
        if (Math.random() < 0.01) { const ex = Math.random() * canvas.width; const ey = canvas.height - 50; for(let i=0; i<20; i++) particles.push(new Particle(ex, ey, (Math.random()-0.5)*10, -Math.random()*10, '#ff4500', 40)); }
        player1.update(); player2.update(); player1.draw(); player2.draw();
        projectiles = projectiles.filter(p => {
            if(p.type === 'pillar') { p.height = Math.min(p.height + 5, p.targetHeight); p.lifetime--; if(p.lifetime <= 0) return false; }
            else { p.x += p.vx; p.y += p.vy; if(p.lifetime !== undefined && p.lifetime-- <= 0) return false; }
            ctx.fillStyle = p.color;
            if (p.type === 'beam') { ctx.fillRect(p.x, p.y, p.width, p.height); ctx.shadowBlur = 20; ctx.shadowColor = p.color; ctx.fillRect(p.x, p.y, p.width, p.height); ctx.shadowBlur = 0; }
            else if (p.type === 'pillar') { ctx.fillRect(p.x, canvas.height - 50 - p.height, p.width, p.height); }
            else if (p.type === 'orb') { ctx.beginPath(); ctx.arc(p.x, p.y, p.width/2, 0, Math.PI * 2); ctx.fill(); ctx.shadowBlur = 10; ctx.shadowColor = p.color; ctx.fill(); ctx.shadowBlur = 0; }
            else { ctx.beginPath(); ctx.arc(p.x + p.width/2, p.y + p.height/2, p.width/2, 0, Math.PI * 2); ctx.fill(); }
            const opponent = p.owner === 1 ? player2 : player1; if (checkCircleRectCollision({x: p.x + p.width/2, y: p.y + p.height/2, radius: p.width/2}, opponent)) { opponent.takeDamage(p.damage); createHitEffect(p.x, p.y); return false; }
            if (p.x < -50 || p.x > canvas.width + 50 || p.y < -50 || p.y > canvas.height + 50) return false; return true;
        });
        particles = particles.filter(p => { p.update(); p.draw(); return p.lifetime > 0; });
        drawUI(); requestAnimationFrame(gameLoop);
    }

    function startGame() { if (!player1Config.power || !player1Config.hair || !player2Config.power || !player2Config.hair) { alert("Both players must select a Power and Hair!"); return; } menuScreen.style.display = 'none'; canvas.style.display = 'block'; gameState = 'PLAYING'; const p1Controls = { up: 'w', down: 's', left: 'a', right: 'd', dash: 'shift', blast: 'f', punch: 'g', kick: 'h', block: 'j', special: 'k', secondary: 'l' }; const p2Controls = { up: 'arrowup', down: 'arrowdown', left: 'arrowleft', right: 'arrowright', dash: 'shiftright', blast: ';', punch: "'", kick: 'enter', block: '/', special: '.', secondary: ',' }; player1 = new Player(200, 300, p1Controls, player1Config, 1); player2 = new Player(650, 300, p2Controls, player2Config, 2); projectiles = []; particles = []; backgroundParticles = []; gameLoop(); }
    function endGame(winner) { gameState = 'END'; winnerText.textContent = `PLAYER ${winner} WINS!`; winnerText.style.color = winner === 1 ? '#00ffff' : '#ff00ff'; canvas.style.display = 'none'; endScreen.style.display = 'flex'; }
    function resetGame() { gameState = 'MENU'; endScreen.style.display = 'none'; menuScreen.style.display = 'flex'; player1Config = { power: null, hair: null }; player2Config = { power: null, hair: null }; document.querySelectorAll('.selected').forEach(btn => btn.classList.remove('selected')); }

    document.getElementById('startButton').addEventListener('click', startGame); document.getElementById('restartButton').addEventListener('click', resetGame);
    document.querySelectorAll('.power-btn, .hair-btn').forEach(button => { button.addEventListener('click', (e) => { const player = e.target.dataset.player; const type = e.target.dataset.type; const value = e.target.dataset.value; document.querySelectorAll(`.p${player}-${type}`).forEach(btn => btn.classList.remove('selected')); e.target.classList.add('selected'); if (player === '1') player1Config[type] = value; else player2Config[type] = value; }); });
    window.addEventListener('keydown', (e) => { keys[e.key.toLowerCase()] = true; }); window.addEventListener('keyup', (e) => { keys[e.key.toLowerCase()] = false; });
    document.querySelector('.p1-power').click(); document.querySelector('.p1-hair').click(); document.querySelector('.p2-power').click(); document.querySelector('.p2-hair').click();
</script>

