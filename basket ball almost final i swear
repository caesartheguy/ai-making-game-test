        class EnergyBeam {
            constructor(x, y, targetX, targetY) {
                this.startX = x;
                this.startY = y;
                this.endX = targetX;
                this.endY = targetY;
                this.width = 80;
                this.active = true;
                this.duration = 30;
                this.timer = 0;
                this.pulsePhase = 0;
                this.lightningOffsets = [];
                this.hasHit = false;
                this.progress = 0;
                this.speed = 0.05;
                
                for (let i = 0; i < 5; i++) {
                    this.lightningOffsets.push({
                        offset: Math.random() * 0.3 + 0.35,
                        amplitude: Math.random() * 30 + 10,
                        frequency: Math.random() * 0.5 + 0.5
                    });
                }
            }
            
            update() {
                if (!this.active) return;
                
                this.timer++;
                this.pulsePhase += 0.3;
                
                if (this.progress < 1) {
                    this.progress = Math.min(1, this.progress + this.speed);
                }
                
                if (this.timer >= this.duration) {
                    this.active = false;
                }
                
                this.lightningOffsets.forEach(offset => {
                    offset.amplitude = Math.sin(this.timer * offset.frequency) * 30 + 10;
                });
            }
            
            draw(ctx) {
                if (!this.active) return;
                
                const alpha = 1 - (this.timer / this.duration);
                ctx.save();
                ctx.globalAlpha = alpha;
                
                const currentEndX = this.startX + (this.endX - this.startX) * this.progress;
                const currentEndY = this.startY + (this.endY - this.startY) * this.progress;
                
                for (let layer = 3; layer > 0; layer--) {
                    const layerWidth = this.width * layer;
                    const layerAlpha = alpha * (0.3 / layer);
                    
                    ctx.globalAlpha = layerAlpha;
                    
                    const gradient = ctx.createLinearGradient(this.startX, this.startY, currentEndX, currentEndY);
                    gradient.addColorStop(0, 'rgba(0, 150, 255, 0.8)');
                    gradient.addColorStop(0.5, 'rgba(0, 200, 255, 1)');
                    gradient.addColorStop(1, 'rgba(0, 100, 255, 0.8)');
                    
                    ctx.strokeStyle = gradient;
                    ctx.lineWidth = layerWidth;
                    ctx.lineCap = 'round';
                    ctx.shadowBlur = 50;
                    ctx.shadowColor = '#00AAFF';
                    
                    ctx.beginPath();
                    ctx.moveTo(this.startX, this.startY);
                    ctx.lineTo(currentEndX, currentEndY);
                    ctx.stroke();
                    
                    ctx.strokeStyle = '#FFFFFF';
                    ctx.lineWidth = layerWidth / 4;
                    ctx.shadowBlur = 20;
                    ctx.shadowColor = '#FFFFFF';
                    
                    this.lightningOffsets.forEach(offset => {
                        const midX = this.startX + (currentEndX - this.startX) * offset.offset;
                        const midY = this.startY + (currentEndY - this.startY) * offset.offset;
                        
                        ctx.beginPath();
                        ctx.moveTo(midX, midY);
                        ctx.lineTo(
                            midX + Math.sin(this.timer * 0.2) * offset.amplitude,
                            midY + Math.cos(this.timer * 0.2) * offset.amplitude
                        );
                        ctx.stroke();
                    });
                }
                
                ctx.globalAlpha = alpha;
                const coreGradient = ctx.createLinearGradient(this.startX, this.startY, currentEndX, currentEndY);
                coreGradient.addColorStop(0, '#FFFFFF');
                coreGradient.addColorStop(0.5, '#00DDFF');
                coreGradient.addColorStop(1, '#FFFFFF');
                
                ctx.strokeStyle = coreGradient;
                ctx.lineWidth = this.width / 2;
                ctx.shadowBlur = 100;
                ctx.shadowColor = '#00DDFF';
                
                ctx.beginPath();
                ctx.moveTo(this.startX, this.startY);
                ctx.lineTo(currentEndX, currentEndY);
                ctx.stroke();
                
                ctx.fillStyle = '#FFFFFF';
                ctx.shadowBlur = 10;
                ctx.shadowColor = '#FFFFFF';
                
                for (let i = 0; i < 20; i++) {
                    const t = (i / 20) + (this.timer * 0.02);
                    if (t <= this.progress) {
                        const x = this.startX + (currentEndX - this.startX) * (t % 1);
                        const y = this.startY + (currentEndY - this.startY) * (t % 1);
                        const size = Math.sin(this.pulsePhase + i) * 3 + 5;
                        
                        ctx.beginPath();
                        ctx.arc(x, y, size, 0, Math.PI * 2);
                        ctx.fill();
                    }
                }
                
                ctx.restore();
            }
            
            checkCollision(player) {
                if (!this.active || player.isDead || this.hasHit) return false;
                
                if (this.progress < 0.95) return false;
                
                const distToStart = Math.hypot(player.x - this.startX, player.y - this.startY);
                const distToEnd = Math.hypot(player.x - this.endX, player.y - this.endY);
                const beamLength = Math.hypot(this.endX - this.startX, this.endY - this.startY);
                
                if (distToStart + distToEnd <= beamLength + 10) {
                    const A = this.endY - this.startY;
                    const B = this.startX - this.endX;
                    const C = this.endX * this.startY - this.startX * this.endY;
                    const perpDist = Math.abs(A * player.x + B * player.y + C) / Math.sqrt(A * A + B * B);
                    
                    if (perpDist < this.width / 2 + player.width / 2) {
                        this.hasHit = true;
                        return true;
                    }
                }
                
                return false;
            }
        }

