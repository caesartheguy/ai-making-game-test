                    this.timeStopAnimation.update();
                    if (!this.timeStopAnimation.active) {
                        this.timeStopAnimation = null;
                    }
                }
                
                if (this.isSprinting && this.sprintStamina > 0) {
                    this.sprintStamina -= this.sprintStaminaDrain;
                    if (this.sprintStamina <= 0) {
                        this.sprintStamina = 0;
                        this.isSprinting = false;
                    }
                } else if (!this.isSprinting && this.sprintStamina < this.maxSprintStamina) {
                    this.sprintStamina += this.sprintStaminaRecovery;
                    this.sprintStamina = Math.min(this.maxSprintStamina, this.sprintStamina);
                }
                
                const canMove = !game.timeStopActive || (game.timeStopActive && this.isDio && this.timeStopActive);
                
                if (canMove && this.stamina > 0) {
                    const isSprintPressed = (this.isPlayer1 && keys['Shift']) || (!this.isPlayer1 && keys['ShiftRight']);
                    
                    if (isSprintPressed && this.sprintStamina > 0) {
                        this.isSprinting = true;
                    } else {
                        this.isSprinting = false;
                    }
                    
                    const speedMultiplier = this.isSprinting ? this.sprintSpeedMultiplier : 1;
                    const currentSpeed = this.data.stats.speed * 0.4 * speedMultiplier;
                    
                    if ((this.isPlayer1 && keys['a']) || (!this.isPlayer1 && keys['ArrowLeft'])) { 
                        this.velocityX = -currentSpeed; 
                        this.stamina -= this.isSprinting ? 0.5 : 0.3; 
                    }
                    if ((this.isPlayer1 && keys['d']) || (!this.isPlayer1 && keys['ArrowRight'])) { 
                        this.velocityX = currentSpeed; 
                        this.stamina -= this.isSprinting ? 0.5 : 0.3; 
                    }
                }
                
                if (canMove && (this.isPlayer1 && keys['w'] && this.y >= canvas.height - 151) || (!this.isPlayer1 && keys['ArrowUp'] && this.y >= canvas.height - 151)) { 
                    this.velocityY = -12; 
                    this.isJumping = true; 
                }
                
                if (this.isDio && this.isPlayer1 && keys['t'] && this.timeStopCooldown <= 0) {
                    this.activateTimeStop();
                }
                
                if (this.hasBall) {
                    const targetHoop = this.isPlayer1 ? game.hoop2 : game.hoop1;
                    const distToHoop = Math.hypot(this.x - targetHoop.x, this.y - targetHoop.y);
                    const isDunkRange = distToHoop < 120;

                    if ((this.isPlayer1 && keys[' ']) || (!this.isPlayer1 && keys['Enter'])) {
                        if (isDunkRange) { this.isDunking = true; this.isShooting = true; }
                        else { this.isShooting = true; this.shotPower = Math.min(this.shotPower + 2, 100); }
                    } else if (this.isShooting) { this.shoot(ball, isDunkRange); }
                }

                if (this.stealCooldown <= 0) {
                    if ((this.isPlayer1 && keys['s']) || (!this.isPlayer1 && keys['ArrowDown'])) {
                        this.attemptSteal(opponent, ball);
                    }
                } else { this.stealCooldown--; }
                
                if (!this.hasBall && opponent.hasBall && opponent.isShooting) {
                    const dist = Math.hypot(this.x - opponent.x, this.y - opponent.y);
                    if (dist < 60) this.isBlocking = true;
                } else this.isBlocking = false;

                this.velocityY += 0.6; this.x += this.velocityX; this.y += this.velocityY; this.velocityX *= 0.85;
                this.x = Math.max(this.width/2, Math.min(canvas.width - this.width/2, this.x));
                if (this.y > canvas.height - 150) { this.y = canvas.height - 150; this.velocityY = 0; this.isJumping = false; this.isDunking = false; }
                this.stamina = Math.min(100, this.stamina + 0.2);
                if (this.powerCooldown > 0) this.powerCooldown -= 16;
                
                if (Math.abs(this.velocityX) > 0.5 && !this.isJumping) { 
                    const walkSpeed = this.isSprinting ? 0.3 : 0.2;
                    this.walkCycle += walkSpeed; 
                } else { 
                    this.walkCycle = 0; 
                }
            }
            
            drawStaminaMeter(ctx) {
                // Draw stamina meter above head
                const meterWidth = 40;
                const meterHeight = 6;
                const meterY = this.y - 60;
                
                // Background
                ctx.fillStyle = 'rgba(0, 0, 0, 0.5)';
                ctx.fillRect(this.x - meterWidth/2, meterY, meterWidth, meterHeight);
                
                // Sprint stamina (yellow/orange)
                const sprintPercent = this.sprintStamina / this.maxSprintStamina;
                const sprintColor = this.isSprinting ? '#FFA500' : '#FFD700';
                ctx.fillStyle = sprintColor;
                ctx.fillRect(this.x - meterWidth/2, meterY, meterWidth * sprintPercent, meterHeight);
                
                // Border
                ctx.strokeStyle = '#FFF';
                ctx.lineWidth = 1;
                ctx.strokeRect(this.x - meterWidth/2, meterY, meterWidth, meterHeight);
                
                // Sprint indicator
                if (this.isSprinting) {
                    ctx.save();
                    ctx.globalAlpha = 0.8;
                    ctx.fillStyle = '#FFA500';
                    ctx.font = 'bold 10px Arial';
                    ctx.textAlign = 'center';
                    ctx.fillText('SPRINT', this.x, meterY - 3);
                    ctx.restore();
                }
            }
            
            activateTimeStop() {
                this.timeStopCooldown = 20000;
                this.timeStopAnimation = new TimeStopEffect(this.x, this.y - 40);
                this.timeStopActive = true;
                this.timeStopAnimationTimer = 60;
                game.timeStopActive = true;
                game.timeStopDuration = 300;
                
                if (game.ball) {
                    game.ball.velocityX = 0;
                    game.ball.velocityY = 0;
                }
                
                game.screenShake = 10;
            }
            
            die() {
                this.isDead = true;
                this.deathTimer = 120;
                this.hasBall = false;
                if (this.ball) {
                    this.ball.holder = null;
                }
            }
            
            respawn() {
                this.isDead = false;
                this.x = this.isPlayer1 ? 200 : canvas.width - 200;
                this.y = canvas.height - 150;
                this.velocityX = 0;
                this.velocityY = 0;
                this.stamina = 100;
                this.sprintStamina = 100;
            }

            attemptSteal(opponent, ball) {
                const dist = Math.hypot(this.x - opponent.x, this.y - opponent.y);
                const stealRange = game.longRangeSteal && this.isPlayer1 ? Infinity : 60;
                
                if (opponent.hasBall && dist < stealRange) {
                    const stealChance = 0.75;
                    
                    this.stamina -= 5;
                    this.isStealing = true;
                    setTimeout(() => this.isStealing = false, 300);

                    if (Math.random() < stealChance) {
                        opponent.hasBall = false;
                        this.hasBall = true;
                        ball.holder = this;
                    }
                }
                this.stealCooldown = 60;
            }

            shoot(ball, isDunk) {
                const power = this.shotPower / 100;
                const targetHoop = this.isPlayer1 ? game.hoop2 : game.hoop1;
                const dx = targetHoop.x - this.x;
                const dy = targetHoop.y - this.y;

                if (isDunk) {
                    this.velocityY = -10;
                    ball.velocityX = dx * 0.06;
                    ball.velocityY = -5;
                } else {
                    let vx, vy;
                    if (game.aimbotEnabled && this.isPlayer1) {
                        vx = (dx / 40);
                        vy = (dy / 40) - 10;
                        const powerMultiplier = 0.4 + power * 0.4;
                        vx *= powerMultiplier;
                        vy *= powerMultiplier;
                        const accuracy = this.data.stats.threePoint / 10;
                        const errorRange = (1 - accuracy) * 4;
                        vx += (Math.random() - 0.5) * errorRange;
                        vy += (Math.random() - 0.5) * errorRange;
                        ball.isAimbotShot = true;
                    } else {
                        vx = (dx / 40);
                        vy = (dy / 40) - 10;
                        const powerMultiplier = 0.4 + power * 0.4;
                        vx *= powerMultiplier;
                        vy *= powerMultiplier;
                        const accuracy = this.data.stats.threePoint / 10;
                        const errorRange = (1 - accuracy) * 4;
                        vx += (Math.random() - 0.5) * errorRange;
                        vy += (Math.random() - 0.5) * errorRange;
                        const blockSuccess = this.isPlayer1 ? game.p2.isBlocking : game.p1.isBlocking;
                        if (blockSuccess) { vx *= 0.5; vy *= 0.5; }
                        ball.isAimbotShot = false;
                    }
                    ball.velocityX = vx;
                    ball.velocityY = vy;
                }
                
                ball.holder = null; ball.isShot = true; ball.shooter = this;
                setTimeout(() => ball.isShot = false, 500);
                this.hasBall = false; this.isShooting = false; this.isDunking = false; this.shotPower = 0;
            }

            draw(ctx) {
                if (this.isDead) {
                    ctx.save();
                    ctx.globalAlpha = 0.5;
                    ctx.translate(this.x, this.y);
                    ctx.scale(1, 0.5);
                    
                    ctx.fillStyle = 'rgba(255, 255, 255, 0.7)';
                    ctx.beginPath();
                    ctx.arc(0, -35, 15, 0, Math.PI * 2);
                    ctx.fill();
                    
                    ctx.fillRect(-15, -20, 30, 30);
                    
                    ctx.beginPath();
                    ctx.moveTo(-15, 10);
                    ctx.lineTo(-10, 20);
                    ctx.lineTo(-5, 15);
                    ctx.lineTo(0, 20);
                    ctx.lineTo(5, 15);
                    ctx.lineTo(10, 20);
                    ctx.lineTo(15, 10);
                    ctx.closePath();
                    ctx.fill();
                    
                    ctx.restore();
                    return;
                }
                
                if (this.timeStopAnimation) {
                    this.timeStopAnimation.draw(ctx);
                }
                
                this.drawStaminaMeter(ctx);
                
                ctx.save(); ctx.translate(this.x, this.y);
                
                if (this.isDio) {
                    this.drawDio(ctx);
                } else {
                    const app = this.data.appearance;
                    const cust = this.customization;

                    let armAngle = 0, legBend = 0, bodyY = 0, bodyStretch = 1;
                    if (this.isDunking) { armAngle = -120; bodyStretch = 1.3; bodyY = -20; }
                    else if (this.isStealing) { armAngle = -150; bodyY = 5; }
                    else if (this.isShooting) { bodyY = this.shotPower * 0.15; legBend = 20; armAngle = -45; }
                    else if (this.isBlocking) { armAngle = -90; }
                    else if (this.isJumping) { legBend = -15; armAngle = 30; }

                    const walkAngle = Math.sin(this.walkCycle) * 20;

                    ctx.fillStyle = '#000'; 
                    ctx.save(); ctx.rotate(walkAngle * Math.PI/180); ctx.fillRect(-15, 35, 12, 8); ctx.restore();
                    ctx.save(); ctx.rotate(-walkAngle * Math.PI/180); ctx.fillRect(3, 35, 12, 8); ctx.restore();
                    
                    ctx.fillStyle = cust.shortsColor; 
                    ctx.save(); ctx.rotate(walkAngle * Math.PI/180); ctx.fillRect(-12, 10, 10, 25); ctx.restore();
                    ctx.save(); ctx.rotate(-walkAngle * Math.PI/180); ctx.fillRect(2, 10, 10, 25); ctx.restore();

                    ctx.fillStyle = cust.shortsColor; ctx.beginPath(); ctx.moveTo(-15, 10); ctx.lineTo(15, 10); ctx.lineTo(12, 25); ctx.lineTo(-12, 25); ctx.closePath(); ctx.fill();
                    
                    ctx.save(); ctx.scale(1, bodyStretch); ctx.translate(0, -bodyY);
                    ctx.fillStyle = cust.jerseyColor; ctx.fillRect(-15, -20, 30, 30);
                    ctx.fillStyle = '#FFF'; ctx.font = 'bold 16px Arial'; ctx.textAlign = 'center'; ctx.fillText(cust.number, 0, -5);
                    ctx.restore();

                    ctx.save(); ctx.rotate(armAngle * Math.PI / 180);
                    ctx.fillStyle = app.skin; ctx.fillRect(-20, -15, 8, 25);
                    ctx.restore();
                    ctx.save(); ctx.rotate(-armAngle * Math.PI / 180);
                    ctx.fillStyle = app.skin; ctx.fillRect(12, -15, 8, 25);
                    ctx.restore();
                    
                    ctx.fillStyle = app.skin; ctx.beginPath(); ctx.arc(0, -35, 15, 0, Math.PI * 2); ctx.fill();
                    ctx.fillStyle = app.hairColor;
                    if (app.hair === 'short') ctx.fillRect(-15, -48, 30, 15);
                    if (app.hair === 'bald') {}
                    ctx.fillStyle = '#FFF'; ctx.fillRect(-5, -38, 4, 4); ctx.fillRect(1, -38, 4, 4);
                    ctx.fillStyle = '#000'; ctx.fillRect(-4, -37, 2, 2); ctx.fillRect(2, -37, 2, 2);
                }
                
                ctx.restore();
            }
            
            drawDio(ctx) {
                const cust = this.customization;
                
                let armAngle = 0, bodyY = 0, jumpHeight = 0;
                
                if (this.timeStopActive) {
                    jumpHeight = Math.min(60, this.timeStopAnimationTimer * 2);
                    armAngle = 90;
                    bodyY = -jumpHeight;
                    
                    this.timeStopAnimationTimer--;
                    if (this.timeStopAnimationTimer <= 0) {
                        this.timeStopActive = false;
                    }
                } else {
                    if (this.isDunking) { armAngle = -120; bodyY = -20; }
                    else if (this.isStealing) { armAngle = -150; bodyY = 5; }
                    else if (this.isShooting) { bodyY = this.shotPower * 0.15; armAngle = -45; }
                    else if (this.isBlocking) { armAngle = -90; }
                    else if (this.isJumping) { armAngle = 30; }
                }
                
                const walkAngle = Math.sin(this.walkCycle) * 20;
                
                ctx.fillStyle = '#000'; 
                ctx.save(); ctx.rotate(walkAngle * Math.PI/180); ctx.fillRect(-15, 35, 12, 8); ctx.restore();
                ctx.save(); ctx.rotate(-walkAngle * Math.PI/180); ctx.fillRect(3, 35, 12, 8); ctx.restore();
                
                ctx.fillStyle = cust.shortsColor; 
                ctx.save(); ctx.rotate(walkAngle * Math.PI/180); ctx.fillRect(-12, 10, 10, 25); ctx.restore();
                ctx.save(); ctx.rotate(-walkAngle * Math.PI/180); ctx.fillRect(2, 10, 10, 25); ctx.restore();

                ctx.fillStyle = cust.shortsColor; ctx.beginPath(); ctx.moveTo(-15, 10); ctx.lineTo(15, 10); ctx.lineTo(12, 25); ctx.lineTo(-12, 25); ctx.closePath(); ctx.fill();
                
                ctx.save(); ctx.translate(0, bodyY);
                ctx.fillStyle = cust.jerseyColor; ctx.fillRect(-15, -20, 30, 30);
                ctx.fillStyle = '#FFF'; ctx.font = 'bold 16px Arial'; ctx.textAlign = 'center'; ctx.fillText(cust.number, 0, -5);
                ctx.restore();
                
                ctx.save(); ctx.rotate(armAngle * Math.PI / 180);
                ctx.fillStyle = '#FDBCB4'; ctx.fillRect(-20, -15, 8, 25);
                ctx.restore();
                ctx.save(); ctx.rotate(-armAngle * Math.PI / 180);
                ctx.fillStyle = '#FDBCB4'; ctx.fillRect(12, -15, 8, 25);
                ctx.restore();
                
                ctx.fillStyle = '#FDBCB4'; ctx.beginPath(); ctx.arc(0, -35, 15, 0, Math.PI * 2); ctx.fill();
                
                ctx.fillStyle = '#FFD700';
                
                ctx.beginPath(); ctx.moveTo(-15, -48); ctx.lineTo(-12, -55); ctx.lineTo(-8, -58); ctx.lineTo(-4, -60); ctx.lineTo(0, -61); ctx.lineTo(4, -60); ctx.lineTo(8, -58); ctx.lineTo(12, -55); ctx.lineTo(15, -48); ctx.lineTo(15, -45); ctx.lineTo(-15, -45); ctx.closePath(); ctx.fill();
                
                ctx.fillRect(-15, -50, 3, 10);
                ctx.fillRect(-11, -55, 3, 12);
                ctx.fillRect(-7, -58, 3, 13);
                ctx.fillRect(-3, -60, 3, 14);
                ctx.fillRect(1, -60, 3, 14);
                ctx.fillRect(5, -58, 3, 13);
                ctx.fillRect(9, -55, 3, 12);
                ctx.fillRect(13, -50, 3, 10);
                
                ctx.fillRect(-18, -45, 5, 8);
                ctx.fillRect(-18, -40, 4, 5);
                ctx.fillRect(13, -45, 5, 8);
                ctx.fillRect(13, -40, 4, 5);
                
                ctx.fillRect(-12, -40, 24, 5);
                ctx.fillRect(-10, -38, 20, 3);
                ctx.fillRect(-8, -36, 16, 2);
                
                ctx.fillStyle = '#FFF'; ctx.fillRect(-5, -38, 4, 4); ctx.fillRect(1, -38, 4, 4);
                ctx.fillStyle = '#000'; ctx.fillRect(-4, -37, 2, 2); ctx.fillRect(2, -37, 2, 2);
                
                ctx.fillStyle = '#FF0000';
                ctx.fillRect(-10, -30, 20, 2);
                ctx.fillRect(-8, -28, 16, 1);
                
                ctx.fillStyle = '#FFD700';
                ctx.beginPath(); ctx.moveTo(0, -48); ctx.lineTo(2, -44); ctx.lineTo(6, -44); ctx.lineTo(3, -41); ctx.lineTo(4, -37); ctx.lineTo(0, -39); ctx.lineTo(-4, -37); ctx.lineTo(-3, -41); ctx.lineTo(-6, -44); ctx.lineTo(-2, -44); ctx.closePath(); ctx.fill();
                
                ctx.fillStyle = '#000';
                ctx.fillRect(-15, -25, 30, 1);
                ctx.fillRect(-12, -24, 24, 1);
                ctx.fillRect(-10, -23, 20, 1);
                
                ctx.beginPath(); ctx.arc(0, -20, 5, 0, Math.PI); ctx.stroke();
            }
        }

        class Ball {
            constructor() { 
                this.reset(); 
                this.radius = 12; 
                this.isShot = false; 
                this.isAimbotShot = false; 
                this.shooter = null;
                this.frozenVelocityX = 0;
                this.frozenVelocityY = 0;
            }
            reset() { 
                this.x = canvas.width / 2; 
                this.y = 100; 
                this.velocityX = 0; 
                this.velocityY = 0; 
                this.holder = null; 
                this.isShot = false; 
                this.isAimbotShot = false; 
                this.shooter = null;
                this.frozenVelocityX = 0;
                this.frozenVelocityY = 0;
            }
            update() {
                if (this.holder) { 
                    this.x = this.holder.x; 
                    this.y = this.holder.y - 20; 
                } else {
                    if (game.timeStopActive) {
                        if (this.holder && this.holder.isDio && this.holder.timeStopActive) {
                            this.x += this.velocityX;
                            this.y += this.velocityY;
                        }
                    } else {
                        if (this.isAimbotShot && game.aimbotEnabled) {
                            const targetHoop = game.p1.isPlayer1 ? game.hoop2 : game.hoop1;
                            const distToHoop = Math.hypot(this.x - targetHoop.x, this.y - targetHoop.y);
                            if (distToHoop < 100) {
                                const dx = targetHoop.x - this.x;
                                const dy = targetHoop.y - this.y;
                                this.velocityX = (dx / distToHoop) * 8;
                                this.velocityY = (dy / distToHoop) * 8;
                            }
                        }

                        this.velocityY += 0.3; 
                        this.x += this.velocityX; 
                        this.y += this.velocityY;
                    }
                    
                    if (this.y + this.radius > canvas.height - 140) { 
                        this.y = canvas.height - 140 - this.radius; 
                        this.velocityY *= -0.5; 
                    }
                    if (this.x - this.radius < 0 || this.x + this.radius > canvas.width) { 
                        this.velocityX *= -0.6; 
                    }
                }
            }
            draw(ctx) {
                ctx.fillStyle = '#FF6600'; 
                ctx.beginPath(); 
                ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2); 
                ctx.fill();
                ctx.strokeStyle = '#000'; 
                ctx.lineWidth = 1; 
                ctx.beginPath(); 
                ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2); 
                ctx.stroke();
                ctx.beginPath(); 
                ctx.moveTo(this.x - this.radius, this.y); 
                ctx.lineTo(this.x + this.radius, this.y);
                ctx.moveTo(this.x, this.y - this.radius); 
                ctx.lineTo(this.x, this.y + this.radius); 
                ctx.stroke();
            }
        }

        class Hoop {
            constructor(x, isPlayer1) { this.x = x; this.y = 250; this.isPlayer1 = isPlayer1; this.shielded = false; this.shieldTimer = 0; }
            update() { if (this.shielded && this.shieldTimer > 0) { this.shieldTimer -= 16; if (this.shieldTimer <= 0) this.shielded = false; } }
            draw(ctx) {
                const backboardOffset = this.isPlayer1 ? -40 : 40;
                ctx.fillStyle = 'rgba(255,255,255,0.9)'; ctx.fillRect(this.x + backboardOffset, this.y - 60, 10, 100);
                ctx.strokeStyle = '#000'; ctx.lineWidth = 3; ctx.strokeRect(this.x + backboardOffset, this.y - 60, 10, 100);
                ctx.strokeStyle = '#FF0000'; ctx.lineWidth = 2; ctx.strokeRect(this.x - 15, this.y - 30, 20, 20);
                ctx.strokeStyle = '#FF4500'; ctx.lineWidth = 5;
                ctx.beginPath(); ctx.ellipse(this.x, this.y, 30, 10, 0, 0, Math.PI * 2); ctx.stroke();
                ctx.strokeStyle = '#FFF'; ctx.lineWidth = 1;
                for(let i = 0; i < 8; i++) {
                    const angle = (Math.PI * 2 / 8) * i;
                    ctx.beginPath();
                    ctx.moveTo(this.x + Math.cos(angle) * 30, this.y + Math.sin(angle) * 10);
                    ctx.lineTo(this.x + Math.cos(angle) * 25, this.y + 40);
                    ctx.stroke();
                }
                if (this.shielded) {
                    ctx.fillStyle = 'rgba(0, 255, 255, 0.3)'; ctx.strokeStyle = 'rgba(0, 255, 255, 0.8)'; ctx.lineWidth = 3;
                    ctx.beginPath(); ctx.arc(this.x, this.y, 50, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
                }
            }
        }

        class Game {
            constructor() {
                this.gameState = 'menu'; this.player1Choice = null; this.player2Choice = null;
                this.p1 = null; this.p2 = null; this.ball = new Ball();
                this.hoop1 = new Hoop(50, true); this.hoop2 = new Hoop(canvas.width - 50, false);
                this.score = { p1: 0, p2: 0 }; this.keys = {}; this.screenShake = 0;
                this.aimbotEnabled = false; this.longRangeSteal = false; this.energyBlastEnabled = false;
                this.energyBeams = []; this.bloodParticles = []; this.explosions = [];
                this.arenaExplosion = null; this.victoryAnimation = null;
                this.winScore = 20;
                this.timeStopActive = false;
                this.timeStopDuration = 0;
                this.setupEventListeners(); this.populateSelectScreen(); this.populateCustomizationScreen(); this.gameLoop();
            }
            setupEventListeners() {
                window.addEventListener('keydown', e => {
                    this.keys[e.key] = true;
                    
                    if (e.key === '1' && this.gameState === 'menu') {
                        this.selectSecretCharacter();
                    }
                    
                    if ((e.key === 'Escape' || e.key === 'p' || e.key === 'P') && this.gameState === 'game') this.pause();
                    
                    if (e.key === 'r' || e.key === 'R') {
                        if (this.gameState === 'game' && this.energyBlastEnabled && this.p1 && !this.p1.isDead) {
                            this.fireEnergyBeam();
                        }
                    }
                });
                window.addEventListener('keyup', e => this.keys[e.key] = false);
                document.getElementById('devButton').addEventListener('click', () => this.openDevPanel());
            }
            
            selectSecretCharacter() {
                this.player1Choice = -1;
                this.showCustomization();
            }
            
            openDevPanel() {
                const password = prompt("Enter password:");
                if (password === "1014") {
                    this.gameState = 'dev';
                    this.showScreen('devScreen');
                }
            }
            toggleAimbot() {
                this.aimbotEnabled = !this.aimbotEnabled;
                const btn = document.getElementById('aimbotToggle');
                btn.textContent = `[${this.aimbotEnabled ? 'ON' : 'OFF'}] Aimbot (P1)`;
                btn.classList.toggle('active', this.aimbotEnabled);
            }
            toggleSteal() {
                this.longRangeSteal = !this.longRangeSteal;
                const btn = document.getElementById('stealToggle');
                btn.textContent = `[${this.longRangeSteal ? 'ON' : 'OFF'}] Global Steal (P1)`;
                btn.classList.toggle('active', this.longRangeSteal);
            }
            toggleEnergyBlast() {
                this.energyBlastEnabled = !this.energyBlastEnabled;
                const btn = document.getElementById('energyBlastToggle');
                btn.textContent = `[${this.energyBlastEnabled ? 'ON' : 'OFF'}] Energy Beam (P1)`;
                btn.classList.toggle('active', this.energyBlastEnabled);
            }
            fireEnergyBeam() {
                if (!this.p1 || this.p1.isDead) return;
                
                const beam = new EnergyBeam(
                    this.p1.x, 
                    this.p1.y - 20, 
                    this.p2.x, 
                    this.p2.y
                );
                
                this.energyBeams.push(beam);
                
                this.screenShake = 25;
            }
            createBloodEffect(x, y) {
                for (let i = 0; i < 50; i++) {
                    this.bloodParticles.push(new BloodParticle(x, y));
                }
                
                for (let i = 0; i < 30; i++) {
                    const mist = new BloodParticle(x, y);
                    mist.size = Math.random() * 30 + 20;
                    mist.velocityX = (Math.random() - 0.5) * 40;
                    mist.velocityY = (Math.random() - 0.5) * 40 - 15;
                    mist.decay = 0.03;
                    this.bloodParticles.push(mist);
                }
            }
            createExplosion(x, y) {
                this.explosions.push(new Explosion(x, y));
            }
            populateSelectScreen() {
                const p1Select = document.getElementById('player1Select');
                const p2Select = document.getElementById('player2Select');
                PLAYER_ROSTER.forEach((p, i) => {
                    p1Select.appendChild(this.createPlayerCard(p, i, 1));
                    p2Select.appendChild(this.createPlayerCard(p, i, 2));
                });
            }
            populateCustomizationScreen() {
                const p1Colors = document.getElementById('p1ColorOptions'); const p2Colors = document.getElementById('p2ColorOptions');
                JERSEY_COLORS.forEach((color, i) => {
                    p1Colors.appendChild(this.createColorOption(color, i, 1));
                    p2Colors.appendChild(this.createColorOption(color, i, 2));
                });
            }
            createPlayerCard(player, index, playerNum) {
                const div = document.createElement('div'); div.className = 'player-card';
                div.innerHTML = `
                    <div class="avatar" style="background-color: ${player.appearance.skin};"></div>
                    <div class="info">
                        <h3>${player.name}</h3>
                        <p>"${player.nickname}"</p>
                        <div class="stats">SPD: ${player.stats.speed} | 3PT: ${player.stats.threePoint} | DUNK: ${player.stats.dunk} | DEF: ${player.stats.defense}</div>
                    </div>
                `;
                div.onclick = () => this.selectPlayer(playerNum, index, div); return div;
            }
            createColorOption(color, index, playerNum) {
                const div = document.createElement('div'); div.className = 'color-option'; div.style.backgroundColor = color;
                div.onclick = () => this.selectColor(playerNum, index, div); return div;
            }
            selectPlayer(playerNum, index, element) {
                document.querySelectorAll(`#player${playerNum}Select .player-card`).forEach(c => c.classList.remove('selected'));
                element.classList.add('selected'); if (playerNum === 1) this.player1Choice = index; else this.player2Choice = index;
            }
            selectColor(playerNum, index, element) {
                document.querySelectorAll(`#p${playerNum}ColorOptions .color-option`).forEach(c => c.classList.remove('selected'));
                element.classList.add('selected'); if (playerNum === 1) this.p1ColorChoice = index; else this.p2ColorChoice = index;
            }
            showScreen(screenId) { 
                document.querySelectorAll('.menu-screen, .select-screen, .customize-screen, .game-ui, .pause-screen, .dev-screen, .victory-screen').forEach(s => s.classList.add('hidden')); 
                document.getElementById(screenId).classList.remove('hidden'); 
            }
            showCustomization() { 
                if (this.player1Choice === null && this.player2Choice === null) {
                    this.showScreen('selectScreen');
                    return;
                }
                
                if (this.player1Choice === -1) {
                    if (this.player2Choice === null) {
                        this.player2Choice = 0;
                    }
                    this.showScreen('customizeScreen');
                    return;
                }
                
                if (this.player1Choice === null || this.player2Choice === null) return; 
                this.showScreen('customizeScreen'); 
            }
            pause() { this.gameState = 'paused'; this.showScreen('pauseScreen'); }
            resume() { this.gameState = 'game'; this.showScreen('gameUI'); }
            startMatch() {
                const p1Data = this.player1Choice === -1 ? DIO_CHARACTER : PLAYER_ROSTER[this.player1Choice];
                const p2Data = PLAYER_ROSTER[this.player2Choice];
                
                const p1Cust = { jerseyColor: JERSEY_COLORS[this.p1ColorChoice || 0], shortsColor: JERSEY_COLORS[this.p1ColorChoice || 0], number: document.getElementById('p1Number').value };
                const p2Cust = { jerseyColor: JERSEY_COLORS[this.p2ColorChoice || 1], shortsColor: JERSEY_COLORS[this.p2ColorChoice || 1], number: document.getElementById('p2Number').value };
                
                this.p1 = new Player(200, true, p1Data, p1Cust);
                this.p2 = new Player(canvas.width - 200, false, p2Data, p2Cust);
                this.ball.holder = this.p1; this.p1.hasBall = true;
                document.getElementById('p1Name').textContent = this.p1.data.name; document.getElementById('p2Name').textContent = this.p2.data.name;
                this.showScreen('gameUI'); this.gameState = 'game';
                
                this.score = { p1: 0, p2: 0 };
                this.p1.streak = 0;
                this.p2.streak = 0;
                background.isDestroyed = false;
                this.arenaExplosion = null;
                this.victoryAnimation = null;
            }
            checkWinCondition() {
                if (this.score.p1 >= this.winScore || this.score.p2 >= this.winScore) {
                    const winner = this.score.p1 >= this.winScore ? this.p1 : this.p2;
                    const loser = this.score.p1 >= this.winScore ? this.p2 : this.p1;
                    const winnerScore = this.score.p1 >= this.winScore ? this.score.p1 : this.score.p2;
                    const loserScore = this.score.p1 >= this.winScore ? this.score.p2 : this.score.p1;
                    
                    this.victoryAnimation = new VictoryAnimation(winner, loser, winnerScore, loserScore);
                    this.gameState = 'victory';
                    
                    document.getElementById('winnerName').textContent = winner.data.name;
                    document.getElementById('victoryStats').textContent = `Final Score: ${winnerScore} - ${loserScore}`;
                    this.showScreen('victoryScreen');
                }
            }
            handleGameLogic() {
                if (this.gameState !== 'game') return;
                
                if (this.timeStopActive) {
                    this.timeStopDuration--;
                    if (this.timeStopDuration <= 0) {
                        this.timeStopActive = false;
                    }
                }
                
                this.p1.update(this.keys, this.ball, this.p2); 
                this.p2.update(this.keys, this.ball, this.p1); 
                
                if (this.timeStopActive) {
                    if (this.ball.holder && this.ball.holder.isDio && this.ball.holder.timeStopActive) {
                        this.ball.update();
                    }
                } else {
                    this.ball.update();
                }
                
                this.hoop1.update(); 
                this.hoop2.update();
                
                this.energyBeams = this.energyBeams.filter(beam => {
                    beam.update();
                    
                    if (beam.checkCollision(this.p2)) {
                        this.createBloodEffect(this.p2.x, this.p2.y);
                        this.createExplosion(this.p2.x, this.p2.y);
                        this.p2.die();
                        this.screenShake = 30;
                        return false;
                    }
                    
                    return beam.active;
                });
                
                this.bloodParticles = this.bloodParticles.filter(particle => {
                    particle.update();
                    return particle.life > 0;
                });
                
                this.explosions = this.explosions.filter(explosion => {
                    explosion.update();
                    return explosion.active;
                });
                
                if (this.arenaExplosion) {
                    this.arenaExplosion.update();
                    if (!this.arenaExplosion.active) {
                        this.arenaExplosion = null;
                    }
                }
                
                if (this.victoryAnimation) {
                    this.victoryAnimation.update();
                }
                
                if (!this.ball.holder && !this.ball.isShot) {
                    const dist1 = Math.hypot(this.p1.x - this.ball.x, this.p1.y - this.ball.y);
                    const dist2 = Math.hypot(this.p2.x - this.ball.x, this.p2.y - this.ball.y);
                    if (dist1 < 30 && !this.p1.isDead) { this.ball.holder = this.p1; this.p1.hasBall = true; }
                    if (dist2 < 30 && !this.p2.isDead) { this.ball.holder = this.p2; this.p2.hasBall = true; }
                }
                if (!this.ball.holder) {
                    if (this.ball.x > this.hoop2.x - 30 && this.ball.x < this.hoop2.x + 30 && this.ball.y > this.hoop2.y - 10 && this.ball.y < this.hoop2.y + 10) { 
                        if (!this.hoop2.shielded) { 
                            this.score.p1++; 
                            this.screenShake = 10; 
                            document.getElementById('score1').textContent = this.score.p1;
                            
                            this.p1.streak++;
                            this.p2.streak = 0;
                            this.updateStreakDisplay();
                            
                            if (this.p1.streak >= 5) {
                                this.arenaExplosion = new ArenaExplosion();
                            }
                            
                            this.checkWinCondition();
                        } 
                        this.resetRound(); 
                    }
                    if (this.ball.x > this.hoop1.x - 30 && this.ball.x < this.hoop1.x + 30 && this.ball.y > this.hoop1.y - 10 && this.ball.y < this.hoop1.y + 10) { 
                        if (!this.hoop1.shielded) { 
                            this.score.p2++; 
                            this.screenShake = 10; 
                            document.getElementById('score2').textContent = this.score.p2;
                            
                            this.p2.streak++;
                            this.p1.streak = 0;
                            this.updateStreakDisplay();
                            
                            if (this.p2.streak >= 5) {
                                this.arenaExplosion = new ArenaExplosion();
                            }
                            
                            this.checkWinCondition();
                        } 
                        this.resetRound(); 
                    }
                }
                document.getElementById('p1Stamina').style.width = `${this.p1.stamina}%`; 
                document.getElementById('p2Stamina').style.width = `${this.p2.stamina}%`;
                document.getElementById('p1Power').style.width = `${100 - (this.p1.powerCooldown / this.p1.data.power.cooldown * 100)}%`;
                document.getElementById('p2Power').style.width = `${100 - (this.p2.powerCooldown / this.p2.data.power.cooldown * 100)}%`;
                
                if (this.p1.isDio) {
                    const timeStopPercent = 100 - (this.p1.timeStopCooldown / 20000 * 100);
                    document.getElementById('p1Power').style.width = `${timeStopPercent}%`;
                }
            }
            updateStreakDisplay() {
                const streak1El = document.getElementById('streak1');
                const streak2El = document.getElementById('streak2');
                
                streak1El.innerHTML = `Streak: ${this.p1.streak}`;
                streak2El.innerHTML = `Streak: ${this.p2.streak}`;
                
                if (this.p1.streak >= 3) {
                    streak1El.innerHTML += '<span class="streak-fire"></span>';
                }
                if (this.p2.streak >= 3) {
                    streak2El.innerHTML += '<span class="streak-fire"></span>';
                }
            }
            resetRound() {
                this.ball.reset(); 
                this.p1.x = 200; 
                this.p1.y = canvas.height - 150; 
                this.p2.x = canvas.width - 200; 
                this.p2.y = canvas.height - 150;
                this.p1.hasBall = false; 
                this.p2.hasBall = false; 
                this.ball.holder = this.score.p1 > this.score.p2 ? this.p2 : this.p1; 
                this.ball.holder.hasBall = true;
            }
            draw() {
                background.draw(this);
                ctx.fillStyle = '#D2691E'; 
                if (background.isDestroyed) {
                    ctx.fillStyle = '#222';
                } else {
                    ctx.fillStyle = '#D2691E';
                }
                ctx.fillRect(0, canvas.height - 140, canvas.width, 140);
                ctx.strokeStyle = '#FFF'; 
                ctx.lineWidth = 3; 
                ctx.beginPath(); 
                ctx.moveTo(0, canvas.height - 140); 
                ctx.lineTo(canvas.width, canvas.height - 140); 
                ctx.stroke();
                
                if (this.screenShake > 0) { 
                    ctx.save(); 
                    ctx.translate((Math.random() - 0.5) * this.screenShake, (Math.random() - 0.5) * this.screenShake); 
                    this.screenShake *= 0.9; 
                }
                
                this.hoop1.draw(ctx); 
                this.hoop2.draw(ctx); 
                this.p1.draw(ctx); 
                this.p2.draw(ctx); 
                this.ball.draw(ctx);
                
                this.energyBeams.forEach(beam => beam.draw(ctx));
                
                this.bloodParticles.forEach(particle => particle.draw(ctx));
                
                this.explosions.forEach(explosion => explosion.draw(ctx));
                
                if (this.arenaExplosion) {
                    this.arenaExplosion.draw(ctx);
                }
                
                if (this.victoryAnimation) {
                    this.victoryAnimation.draw(ctx);
                }
                
                if (this.timeStopActive) {
                    ctx.save();
                    ctx.fillStyle = 'rgba(128, 0, 255, 0.1)';
                    ctx.fillRect(0, 0, canvas.width, canvas.height);
                    
                    ctx.fillStyle = '#FFD700';
                    ctx.font = 'bold 40px Press Start 2P';
                    ctx.textAlign = 'center';
                    ctx.fillText('TIME HAS STOPPED!', canvas.width / 2, 100);
                    
                    const timeRemaining = Math.ceil(this.timeStopDuration / 60);
                    ctx.font = 'bold 20px VT323';
                    ctx.fillText(`${timeRemaining}s`, canvas.width / 2, 130);
                    
                    ctx.restore();
                }
                
                if (this.screenShake > 0) ctx.restore();
            }
            gameLoop() {
                if (this.gameState === 'game') { 
                    this.handleGameLogic(); 
                    this.draw(); 
                }
                else if (this.gameState === 'paused' || this.gameState === 'dev') { 
                    this.draw(); 
                }
                else if (this.gameState === 'victory') {
                    this.draw();
                    if (this.victoryAnimation) {
                        this.victoryAnimation.update();
                    }
                }
                requestAnimationFrame(() => this.gameLoop());
            }
        }
        const game = new Game();
    </script>
</body>
</html>
