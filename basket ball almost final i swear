<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Basketball Stars Ultimate</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Press+Start+2P&family=VT323&display=swap');
        
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #1e3c72, #2a5298);
            font-family: 'Bebas Neue', cursive;
            color: white;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            overflow: hidden;
        }

        #gameContainer {
            position: relative;
            width: 1000px;
            height: 600px;
            border: 5px solid #fff;
            box-shadow: 0 0 25px rgba(0,0,0,0.5);
        }

        canvas {
            position: absolute;
            top: 0;
            left: 0;
        }

        .ui-layer {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
        }

        .menu-screen, .select-screen, .customize-screen, .pause-screen, .dev-screen, .victory-screen {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.9);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            pointer-events: all;
        }
        .menu-screen h1 {
            font-family: 'Press Start 2P', cursive;
            font-size: 4em;
            color: #FFD700;
            text-shadow: 3px 3px #000;
            margin-bottom: 50px;
        }
        .menu-button {
            font-family: 'Bebas Neue', cursive;
            font-size: 2em;
            padding: 15px 40px;
            margin: 10px;
            background: #FFD700;
            color: #000;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .menu-button:hover { transform: scale(1.1); box-shadow: 0 0 15px #FFD700; }
        .hidden { display: none !important; }

        /* Victory Screen */
        .victory-screen {
            background: linear-gradient(135deg, #1a1a1a, #333);
            z-index: 100;
        }
        .victory-title {
            font-family: 'Press Start 2P', cursive;
            font-size: 3em;
            color: #FFD700;
            text-shadow: 3px 3px #000;
            margin-bottom: 30px;
            animation: pulse 1s infinite alternate;
        }
        @keyframes pulse {
            from { transform: scale(1); }
            to { transform: scale(1.05); }
        }
        .winner-name {
            font-family: 'Bebas Neue', cursive;
            font-size: 2.5em;
            color: #FFD700;
            margin-bottom: 20px;
        }
        .victory-stats {
            font-family: 'VT323', monospace;
            font-size: 1.5em;
            margin-bottom: 30px;
        }

        /* REFINED CHARACTER SELECT SCREEN */
        .select-screen {
            width: 850px;
            height: 500px;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: rgba(20, 20, 20, 0.98);
            border: 3px solid #FFD700;
            border-radius: 15px;
            box-shadow: 0 0 30px rgba(255, 215, 0, 0.5);
            backdrop-filter: blur(5px);
        }
        .select-header {
            font-family: 'Press Start 2P', cursive;
            font-size: 2.5em;
            color: #FFD700;
            text-shadow: 2px 2px #000;
            margin-bottom: 20px;
        }
        .select-content-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
            padding: 0 20px;
        }
        .player-column {
            display: flex;
            flex-direction: column;
            align-items: center;
            width: 45%;
        }
        .player-title {
            font-family: 'Bebas Neue', cursive;
            font-size: 1.8em;
            color: #fff;
            margin-bottom: 15px;
            padding-bottom: 10px;
            border-bottom: 2px solid #444;
            width: 100%;
        }
        .player-title.p1 { color: #3498db; border-color: #3498db; }
        .player-title.p2 { color: #e74c3c; border-color: #e74c3c; }
        .player-card-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
            max-height: 300px;
            overflow-y: auto;
            width: 100%;
        }
        .player-card {
            background: linear-gradient(145deg, #4a4a4a, #2a2a2a);
            border: 2px solid #555;
            padding: 10px;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            border-radius: 8px;
        }
        .player-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.4);
            border-color: #FFD700;
        }
        .player-card.selected {
            border-color: #00FF00;
            box-shadow: 0 0 10px #00FF00;
            background: linear-gradient(145deg, #3a5a3a, #1a2a1a);
        }
        .player-card .avatar {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            margin-right: 15px;
            background-size: cover;
            background-color: #ccc;
        }
        .player-card .info {
            text-align: left;
        }
        .player-card h3 { font-size: 1.4em; margin: 0 0 5px 0; }
        .player-card p { font-size: 0.9em; margin: 0; color: #ccc; }
        .vs-text {
            font-family: 'Press Start 2P', cursive;
            font-size: 2.5em;
            color: #fff;
            text-shadow: 2px 2px #000;
            margin: 0 20px;
        }
        
        .customize-container { display: flex; gap: 100px; }
        .customization-panel { background: #444; padding: 20px; border-radius: 10px; }
        .customization-panel h3 { font-size: 2em; border-bottom: 2px solid #FFD700; padding-bottom: 10px; }
        .color-options, .number-input { margin-top: 15px; }
        .color-option {
            width: 40px; height: 40px; border: 2px solid #fff; display: inline-block; margin: 5px;
            cursor: pointer; transition: transform 0.2s;
        }
        .color-option:hover { transform: scale(1.2); }
        .color-option.selected { border-color: '#FFD700'; box-shadow: 0 0 10px #FFD700; }
        .number-input input { font-family: 'Bebas Neue'; font-size: 2em; width: 80px; text-align: center; }

        .game-ui { display: none; pointer-events: all; }
        .score-display { position: absolute; top: 20px; font-size: 3em; text-shadow: 2px 2px #000; }
        .score-display.p1 { left: 20px; }
        .score-display.p2 { right: 20px; }
        .streak-display { 
            position: absolute; 
            top: 70px; 
            font-size: 1.5em; 
            text-shadow: 2px 2px #000;
            display: flex;
            align-items: center;
        }
        .streak-display.p1 { left: 20px; }
        .streak-display.p2 { right: 20px; }
        .streak-fire {
            display: inline-block;
            width: 20px;
            height: 20px;
            margin-left: 5px;
            background: radial-gradient(circle, #FFA500, #FF4500);
            border-radius: 50%;
            animation: flicker 0.5s infinite alternate;
        }
        @keyframes flicker {
            0% { opacity: 0.7; transform: scale(0.9); }
            100% { opacity: 1; transform: scale(1.1); }
        }
        .player-info { position: absolute; bottom: 20px; width: 200px; text-align: center; }
        .player-info.p1 { left: 20px; }
        .player-info.p2 { right: 20px; }
        .player-name { font-size: 1.5em; }
        .stamina-bar, .power-bar { width: 100%; height: 20px; background: #555; border: 2px solid #fff; margin-top: 5px; }
        .stamina-fill { background: #0f0; height: 100%; transition: width 0.2s; }
        .power-fill { background: #f0f; height: 100%; transition: width 0.2s; }

        .pause-screen h2, .dev-screen h2 { font-size: 3em; margin-bottom: 30px; }
        .controls-container { display: flex; gap: 50px; text-align: left; }
        .controls-container h3 { font-size: 1.5em; color: #FFD700; border-bottom: 1px solid #FFD700; padding-bottom: 5px; margin-bottom: 10px;}
        .controls-container p { font-size: 1.1em; margin: 5px 0; }
        
        #devButton {
            position: absolute;
            top: 10px;
            right: 10px;
            padding: 5px 10px;
            background: rgba(0,0,0,0.5);
            color: #FFD700;
            border: 1px solid #FFD700;
            font-family: 'VT323', monospace;
            font-size: 1em;
            cursor: pointer;
            z-index: 1000;
            border-radius: 5px;
            pointer-events: all;
        }
        #devButton:hover { background: rgba(255,215,0,0.2); }
        .dev-screen {
            font-family: 'VT323', monospace;
            background: rgba(0, 20, 0, 0.95);
            color: #00FF00;
            text-align: left;
            padding: 20px;
            align-items: flex-start;
        }
        .dev-screen h2 { color: '#00FF00'; text-shadow: 0 0 5px #00FF00; }
        .dev-controls {
            display: flex;
            flex-direction: column;
            gap: 15px;
            font-size: 1.5em;
        }
        .dev-toggle {
            background: #111;
            border: 1px solid #00FF00;
            color: #00FF00;
            padding: 10px;
            cursor: pointer;
            transition: background 0.2s, color 0.2s;
        }
        .dev-toggle.active {
            background: #00FF00;
            color: '#111';
        }
        
        /* Time Stop Effect */
        .time-stop-effect {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 50;
        }
        
        .secret-hint {
            position: absolute;
            bottom: 10px;
            left: 50%;
            transform: translateX(-50%);
            font-family: 'VT323', monospace;
            font-size: 1em;
            color: rgba(255, 255, 255, 0.3);
            pointer-events: none;
        }
    </style>
</head>
<body>
    <div id="gameContainer">
        <canvas id="gameCanvas" width="1000" height="600"></canvas>
        <div class="ui-layer">
            <button id="devButton">DEV</button>

            <div id="menuScreen" class="menu-screen">
                <h1>Basketball Stars</h1>
                <button class="menu-button" onclick="game.showScreen('selectScreen')">Start Game</button>
            </div>
            <div id="selectScreen" class="select-screen hidden">
                <div class="select-header">SELECT YOUR PLAYERS</div>
                <div class="select-content-container">
                    <div class="player-column">
                        <div class="player-title p1">PLAYER 1</div>
                        <div class="player-card-list" id="player1Select"></div>
                    </div>
                    <div class="vs-text">VS</div>
                    <div class="player-column">
                        <div class="player-title p2">PLAYER 2</div>
                        <div class="player-card-list" id="player2Select"></div>
                    </div>
                </div>
                <button class="menu-button" onclick="game.showCustomization()">Customize & Start</button>
                <div class="secret-hint">Press 1 for a secret character...</div>
            </div>
            <div id="customizeScreen" class="customize-screen hidden">
                <h2>Customize Your Players</h2>
                <div class="customize-container">
                    <div class="customization-panel">
                        <h3>Player 1</h3>
                        <div class="color-options" id="p1ColorOptions"></div>
                        <div class="number-input">
                            <label>Number: </label>
                            <input type="number" id="p1Number" min="0" max="99" value="1">
                        </div>
                    </div>
                    <div class="customization-panel">
                        <h3>Player 2</h3>
                        <div class="color-options" id="p2ColorOptions"></div>
                        <div class="number-input">
                            <label>Number: </label>
                            <input type="number" id="p2Number" min="0" max="99" value="2">
                        </div>
                    </div>
                </div>
                <button class="menu-button" onclick="game.startMatch()">Start Match</button>
            </div>
            <div id="pauseScreen" class="pause-screen hidden">
                <h2>PAUSED</h2>
                <div class="controls-container">
                    <div>
                        <h3>Player 1 (Blue)</h3>
                        <p>Move: A / D</p>
                        <p>Sprint: Hold Shift</p>
                        <p>Jump: W</p>
                        <p>Shoot: Space</p>
                        <p>Steal: S</p>
                        <p>Energy Beam: R</p>
                        <p>Time Stop: T (Dio Only)</p>
                    </div>
                    <div>
                        <h3>Player 2 (Red)</h3>
                        <p>Move: Arrow Left / Right</p>
                        <p>Sprint: Hold Right Shift</p>
                        <p>Jump: Arrow Up</p>
                        <p>Shoot: Enter</p>
                        <p>Steal: Down Arrow</p>
                    </div>
                </div>
                <button class="menu-button" onclick="game.resume()">Resume</button>
            </div>
            <div id="devScreen" class="dev-screen hidden">
                <h2>&gt; DEVELOPER PANEL</h2>
                <div class="dev-controls">
                    <button id="aimbotToggle" class="dev-toggle" onclick="game.toggleAimbot()">[OFF] Aimbot (P1)</button>
                    <button id="stealToggle" class="dev-toggle" onclick="game.toggleSteal()">[OFF] Global Steal (P1)</button>
                    <button id="energyBlastToggle" class="dev-toggle" onclick="game.toggleEnergyBlast()">[OFF] Energy Beam (P1)</button>
                </div>
                <button class="menu-button" style="margin-top: 20px;" onclick="game.resume()">Close Panel</button>
            </div>
            <div id="victoryScreen" class="victory-screen hidden">
                <div class="victory-title">VICTORY!</div>
                <div class="winner-name" id="winnerName">PLAYER 1</div>
                <div class="victory-stats" id="victoryStats">Final Score: 20 - 0</div>
                <button class="menu-button" onclick="game.showScreen('menuScreen')">Main Menu</button>
            </div>
            <div id="gameUI" class="game-ui">
                <div class="score-display p1" id="score1">0</div>
                <div class="score-display p2" id="score2">0</div>
                <div class="streak-display p1" id="streak1">
                    Streak: 0
                </div>
                <div class="streak-display p2" id="streak2">
                    Streak: 0
                </div>
                <div class="player-info p1">
                    <div class="player-name" id="p1Name">P1</div>
                    <div class="stamina-bar"><div class="stamina-fill" id="p1Stamina" style="width: 100%;"></div></div>
                    <div class="power-bar"><div class="power-fill" id="p1Power" style="width: 100%;"></div></div>
                </div>
                <div class="player-info p2">
                    <div class="player-name" id="p2Name">P2</div>
                    <div class="stamina-bar"><div class="stamina-fill" id="p2Stamina" style="width: 100%;"></div></div>
                    <div class="power-bar"><div class="power-fill" id="p2Power" style="width: 100%;"></div></div>
                </div>
            </div>
            <div id="timeStopEffect" class="time-stop-effect"></div>
        </div>
    </div>

    <script>
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');

        // --- Dynamic Background Elements ---
        const background = {
            clouds: [
                { x: 100, y: 50, speed: 0.2, scale: 1 },
                { x: 400, y: 80, speed: 0.15, scale: 0.8 },
                { x: 700, y: 40, speed: 0.25, scale: 1.2 },
                { x: 900, y: 90, speed: 0.1, scale: 0.9 }
            ],
            hills: [
                { x: 0, y: 450, width: 400, height: 150, speed: 0.05, color: '#2a5a2a' },
                { x: 350, y: 480, width: 500, height: 120, speed: 0.08, color: '#1e4a1e' },
                { x: 750, y: 460, width: 350, height: 140, speed: 0.06, color: '#235023' }
            ],
            scoreboard: {
                x: canvas.width / 2 - 120,
                y: 180,
                width: 240,
                height: 90,
                draw(game) {
                    ctx.fillStyle = '#1a1a1a';
                    ctx.fillRect(this.x, this.y, this.width, this.height);
                    ctx.strokeStyle = '#888';
                    ctx.lineWidth = 2;
                    ctx.strokeRect(this.x, this.y, this.width, this.height);
                    ctx.fillStyle = '#FF4500';
                    ctx.font = 'bold 48px VT323';
                    ctx.textAlign = 'center';
                    ctx.fillText(game.score.p1, this.x + this.width * 0.25, this.y + this.height * 0.65);
                    ctx.fillText(game.score.p2, this.x + this.width * 0.75, this.y + this.height * 0.65);
                    ctx.fillStyle = '#FFF';
                    ctx.fillRect(this.x + this.width * 0.45, this.y + 20, this.width * 0.1, this.height - 40);
                    ctx.font = 'bold 20px Bebas Neue';
                    ctx.fillText('P1', this.x + this.width * 0.25, this.y + 30);
                    ctx.fillText('P2', this.x + this.width * 0.75, this.y + 30);
                }
            },
            isDestroyed: false,
            draw(game) {
                if (this.isDestroyed) {
                    const gradient = ctx.createLinearGradient(0, 0, 0, canvas.height);
                    gradient.addColorStop(0, '#333');
                    gradient.addColorStop(0.6, '#222');
                    gradient.addColorStop(1, '#111');
                    ctx.fillStyle = gradient;
                    ctx.fillRect(0, 0, canvas.width, canvas.height);
                    
                    for (let i = 0; i < 20; i++) {
                        const x = Math.random() * canvas.width;
                        const y = canvas.height - Math.random() * 200;
                        const size = Math.random() * 30 + 10;
                        const flicker = Math.random() * 0.3 + 0.7;
                        
                        ctx.save();
                        ctx.globalAlpha = flicker;
                        
                        const fireGradient = ctx.createRadialGradient(x, y, 0, x, y, size);
                        fireGradient.addColorStop(0, 'rgba(255, 255, 0, 0.8)');
                        fireGradient.addColorStop(0.5, 'rgba(255, 100, 0, 0.5)');
                        fireGradient.addColorStop(1, 'rgba(255, 0, 0, 0)');
                        
                        ctx.fillStyle = fireGradient;
                        ctx.beginPath();
                        ctx.arc(x, y, size, 0, Math.PI * 2);
                        ctx.fill();
                        
                        ctx.restore();
                    }
                    
                    this.hills.forEach(hill => {
                        ctx.fillStyle = '#222';
                        ctx.beginPath();
                        ctx.moveTo(hill.x, canvas.height);
                        ctx.lineTo(hill.x + hill.width / 4, hill.y);
                        ctx.lineTo(hill.x + hill.width / 2, hill.y - 20);
                        ctx.lineTo(hill.x + hill.width * 0.75, hill.y);
                        ctx.lineTo(hill.x + hill.width, canvas.height);
                        ctx.closePath();
                        ctx.fill();
                        hill.x -= hill.speed;
                        if (hill.x + hill.width < 0) hill.x = canvas.width;
                    });
                    
                    ctx.fillStyle = '#222';
                    ctx.fillRect(this.scoreboard.x - 5, this.scoreboard.y - 5, this.scoreboard.width + 10, this.scoreboard.height + 10);
                    ctx.strokeStyle = '#444';
                    ctx.lineWidth = 1;
                    ctx.strokeRect(this.scoreboard.x - 5, this.scoreboard.y - 5, this.scoreboard.width + 10, this.scoreboard.height + 10);
                    
                    ctx.fillStyle = '#333';
                    ctx.fillRect(this.scoreboard.x + 10, this.scoreboard.y + 10, this.scoreboard.width - 20, this.scoreboard.height - 20);
                    
                    ctx.fillStyle = '#666';
                    ctx.font = 'bold 48px VT323';
                    ctx.textAlign = 'center';
                    ctx.fillText(game.score.p1, this.scoreboard.x + this.scoreboard.width * 0.25, this.scoreboard.y + this.scoreboard.height * 0.65);
                    ctx.fillText(game.score.p2, this.scoreboard.x + this.scoreboard.width * 0.75, this.scoreboard.y + this.scoreboard.height * 0.65);
                } else {
                    const gradient = ctx.createLinearGradient(0, 0, 0, canvas.height);
                    gradient.addColorStop(0, '#87CEEB');
                    gradient.addColorStop(0.6, '#98D8E8');
                    gradient.addColorStop(1, '#F0E68C');
                    ctx.fillStyle = gradient;
                    ctx.fillRect(0, 0, canvas.width, canvas.height);
                    this.hills.forEach(hill => {
                        ctx.fillStyle = hill.color;
                        ctx.beginPath();
                        ctx.moveTo(hill.x, canvas.height);
                        ctx.lineTo(hill.x + hill.width / 4, hill.y);
                        ctx.lineTo(hill.x + hill.width / 2, hill.y - 20);
                        ctx.lineTo(hill.x + hill.width * 0.75, hill.y);
                        ctx.lineTo(hill.x + hill.width, canvas.height);
                        ctx.closePath();
                        ctx.fill();
                        hill.x -= hill.speed;
                        if (hill.x + hill.width < 0) hill.x = canvas.width;
                    });
                    this.scoreboard.draw(game);
                }
                
                this.clouds.forEach(cloud => {
                    ctx.fillStyle = 'rgba(255, 255, 255, 0.8)';
                    ctx.save();
                    ctx.translate(cloud.x, cloud.y);
                    ctx.scale(cloud.scale, cloud.scale);
                    ctx.beginPath();
                    ctx.arc(0, 0, 25, 0, Math.PI * 2);
                    ctx.arc(25, 0, 35, 0, Math.PI * 2);
                    ctx.arc(50, 0, 25, 0, Math.PI * 2);
                    ctx.arc(15, -15, 20, 0, Math.PI * 2);
                    ctx.arc(35, -10, 25, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.restore();
                    cloud.x -= cloud.speed;
                    if (cloud.x < -100 * cloud.scale) cloud.x = canvas.width + 100 * cloud.scale;
                });
            }
        };

        const JERSEY_COLORS = ['#FF0000', '#0000FF', '#00FF00', '#FFA500', '#800080', '#FFD700', '#000000', '#FFFFFF'];
        const PLAYER_ROSTER = [
            { name: "Flash", nickname: "The Blur", stats: { speed: 7, threePoint: 6, dunk: 7, defense: 5 }, appearance: { skin: '#8D5524', hair: 'short', hairColor: '#000' }, power: { name: 'Mega Dunk', type: 'dunk', cooldown: 12000 } },
            { name: "Sharpshooter", nickname: "Deadeye", stats: { speed: 4.5, threePoint: 10, dunk: 4, defense: 6 }, appearance: { skin: '#FDBCB4', hair: 'short', hairColor: '#FFD700' }, power: { name: 'Mega Shot', type: 'shot', cooldown: 10000 } },
            { name: "The Hammer", nickname: "Wrecker", stats: { speed: 5, threePoint: 3, dunk: 10, defense: 8 }, appearance: { skin: '#AE5D29', hair: 'bald', hairColor: '#000' }, power: { name: 'Hoop Shield', type: 'defense', cooldown: 15000 } },
            { name: "Wall", nickname: "The Fortress", stats: { speed: 4, threePoint: 5, dunk: 6, defense: 10 }, appearance: { skin: '#8D5524', hair: 'short', hairColor: '#000' }, power: { name: 'Hoop Shield', type: 'defense', cooldown: 15000 } },
        ];
        
        const DIO_CHARACTER = {
            name: "DIO",
            nickname: "The World",
            stats: { speed: 8, threePoint: 7, dunk: 9, defense: 6 },
            appearance: { skin: '#FDBCB4', hair: 'long', hairColor: '#FFD700' },
            power: { name: 'Time Stop', type: 'special', cooldown: 20000 },
            isSecret: true
        };

        class TimeStopEffect {
            constructor(x, y) {
                this.x = x;
                this.y = y;
                this.radius = 10;
                this.maxRadius = 800;
                this.expansionSpeed = 6;
                this.active = true;
                this.opacity = 0.9;
                this.colorInvert = true;
                this.particles = [];
                
                for (let i = 0; i < 50; i++) {
                    this.particles.push({
                        angle: (Math.PI * 2 / 50) * i,
                        distance: Math.random() * 50 + 20,
                        size: Math.random() * 4 + 1,
                        speed: Math.random() * 0.02 + 0.01,
                        opacity: Math.random() * 0.5 + 0.5
                    });
                }
            }
            
            update() {
                if (!this.active) return;
                
                this.radius += this.expansionSpeed;
                this.opacity = 0.9 * (1 - (this.radius / this.maxRadius));
                
                this.particles.forEach(p => {
                    p.angle += p.speed;
                    p.distance += 3;
                    p.opacity *= 0.98;
                });
                
                if (this.radius >= this.maxRadius) {
                    this.active = false;
                }
            }
            
            draw(ctx) {
                if (!this.active) return;
                
                ctx.save();
                
                ctx.globalCompositeOperation = 'difference';
                ctx.fillStyle = `rgba(255, 255, 255, ${this.opacity})`;
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
                ctx.fill();
                
                ctx.globalCompositeOperation = 'difference';
                ctx.fillStyle = `rgba(200, 200, 255, ${this.opacity * 0.5})`;
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.radius * 0.95, 0, Math.PI * 2);
                ctx.fill();
                
                ctx.globalCompositeOperation = 'source-over';
                ctx.strokeStyle = `rgba(255, 215, 0, ${this.opacity})`;
                ctx.lineWidth = 8;
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
                ctx.stroke();
                
                ctx.strokeStyle = `rgba(138, 43, 226, ${this.opacity * 0.7})`;
                ctx.lineWidth = 15;
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.radius * 0.95, 0, Math.PI * 2);
                ctx.stroke();
                
                ctx.strokeStyle = `rgba(255, 0, 255, ${this.opacity * 0.5})`;
                ctx.lineWidth = 20;
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.radius * 1.05, 0, Math.PI * 2);
                ctx.stroke();
                
                this.particles.forEach(p => {
                    if (p.opacity > 0.1) {
                        ctx.save();
                        ctx.globalAlpha = p.opacity;
                        ctx.fillStyle = '#FFD700';
                        const px = this.x + Math.cos(p.angle) * p.distance;
                        const py = this.y + Math.sin(p.angle) * p.distance;
                        ctx.beginPath();
                        ctx.arc(px, py, p.size, 0, Math.PI * 2);
                        ctx.fill();
                        ctx.restore();
                    }
                });
                
                ctx.restore();
            }
        }

