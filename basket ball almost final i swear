            }
            
            update() {
                if (!this.active) return;
                
                this.shockwave.radius += this.shockwave.speed;
                this.shockwave.alpha = 1 - (this.shockwave.radius / this.shockwave.maxRadius);
                
                this.particles.forEach(p => {
                    p.x += p.vx;
                    p.y += p.vy;
                    p.vy += 0.5;
                    p.vx *= 0.98;
                    p.life -= 0.02;
                });
                
                this.debris.forEach(d => {
                    d.x += d.vx;
                    d.y += d.vy;
                    d.vy += 0.3;
                    d.vx *= 0.95;
                    d.rotation += d.rotationSpeed;
                    d.life -= 0.01;
                });
                
                if (this.shockwave.radius > this.shockwave.maxRadius * 0.3 && !this.smokeText.showText) {
                    this.smokeText.showText = true;
                }
                
                if (this.smokeText.showText) {
                    this.textTimer++;
                    
                    if (this.smokeText.size < this.smokeText.maxSize) {
                        this.smokeText.size = Math.min(this.smokeText.maxSize, this.smokeText.size + 8);
                    }
                    
                    if (this.smokeText.alpha < 1) {
                        this.smokeText.alpha = Math.min(1, this.smokeText.alpha + 0.08);
                    }
                    
                    this.smokeText.rotation += 0.02;
                    
                    this.smokeText.y -= 0.8;
                    this.smokeText.x += Math.sin(this.textTimer * 0.1) * 2;
                }
                
                if (this.shockwave.radius >= this.shockwave.maxRadius) {
                    this.active = false;
                    background.isDestroyed = true;
                }
            }
            
            draw(ctx) {
                if (!this.active) return;
                
                ctx.save();
                ctx.globalAlpha = this.shockwave.alpha * 0.5;
                ctx.strokeStyle = '#FFFFFF';
                ctx.lineWidth = 5;
                ctx.beginPath();
                ctx.arc(canvas.width / 2, canvas.height / 2, this.shockwave.radius, 0, Math.PI * 2);
                ctx.stroke();
                
                ctx.globalAlpha = this.shockwave.alpha * 0.3;
                ctx.strokeStyle = '#FFA500';
                ctx.lineWidth = 10;
                ctx.beginPath();
                ctx.arc(canvas.width / 2, canvas.height / 2, this.shockwave.radius * 0.9, 0, Math.PI * 2);
                ctx.stroke();
                ctx.restore();
                
                this.particles.forEach(p => {
                    ctx.save();
                    ctx.globalAlpha = p.life;
                    ctx.fillStyle = p.color;
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.restore();
                });
                
                this.debris.forEach(d => {
                    ctx.save();
                    ctx.globalAlpha = d.life;
                    ctx.translate(d.x, d.y);
                    ctx.rotate(d.rotation);
                    ctx.fillStyle = d.color;
                    ctx.fillRect(-d.size/2, -d.size/2, d.size, d.size);
                    ctx.restore();
                });
                
                if (this.smokeText.showText && this.smokeText.size > 0) {
                    ctx.save();
                    
                    for (let layer = 0; layer < 5; layer++) {
                        ctx.save();
                        ctx.globalAlpha = this.smokeText.alpha * (0.3 + layer * 0.1);
                        ctx.translate(this.smokeText.x, this.smokeText.y);
                        ctx.rotate(this.smokeText.rotation + (layer * 0.1));
                        
                        const wobbleX = Math.sin(this.textTimer * 0.15 + layer) * 15;
                        const wobbleY = Math.cos(this.textTimer * 0.12 + layer) * 10;
                        const scale = 1 + Math.sin(this.textTimer * 0.08 + layer) * 0.2;
                        
                        ctx.translate(wobbleX, wobbleY);
                        ctx.scale(scale, scale);
                        
                        const smokeGradient = ctx.createLinearGradient(-this.smokeText.size, 0, this.smokeText.size, 0);
                        smokeGradient.addColorStop(0, 'rgba(200, 200, 200, 0.2)');
                        smokeGradient.addColorStop(0.5, 'rgba(255, 255, 255, 0.8)');
                        smokeGradient.addColorStop(1, 'rgba(200, 200, 200, 0.2)');
                        
                        ctx.fillStyle = smokeGradient;
                        ctx.font = `bold ${this.smokeText.size}px Press Start 2P`;
                        ctx.textAlign = 'center';
                        ctx.textBaseline = 'middle';
                        ctx.fillText(this.smokeText.text, 0, 0);
                        
                        ctx.shadowColor = 'rgba(0, 0, 0, 0.5)';
                        ctx.shadowBlur = 10;
                        ctx.shadowOffsetX = 5;
                        ctx.shadowOffsetY = 5;
                        
                        ctx.restore();
                    }
                    
                    ctx.restore();
                    
                    ctx.save();
                    ctx.globalAlpha = this.smokeText.alpha;
                    ctx.translate(this.smokeText.x, this.smokeText.y);
                    ctx.rotate(this.smokeText.rotation);
                    
                    ctx.shadowColor = '#FFFFFF';
                    ctx.shadowBlur = 20;
                    ctx.fillStyle = '#FFFFFF';
                    ctx.font = `bold ${this.smokeText.size}px Press Start 2P`;
                    ctx.textAlign = 'center';
                    ctx.textBaseline = 'middle';
                    ctx.fillText(this.smokeText.text, 0, 0);
                    
                    ctx.strokeStyle = '#000000';
                    ctx.lineWidth = 3;
                    ctx.strokeText(this.smokeText.text, 0, 0);
                    
                    ctx.restore();
                }
            }
        }

